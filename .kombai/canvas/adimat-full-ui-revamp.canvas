    "var_bbb29f4e82cb": {
      "type": "variant",
      "label": "Public checkout · mobile",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1316.3157894736844,
        "y": -138.1578947368421,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen w-full bg-[var(--color-surface)] font-sans text-[var(--color-ink)]\" data-kid=\"1\" data-name=\"page layout container\" style=\"--color-primary:#065f46;--color-primary-dark:#064e3b;--color-primary-light:#059669;--color-primary-subtle:#ecfdf5;--color-surface:#f8fafc;--color-surface-muted:#f1f5f4;--color-surface-card:#ffffff;--color-border:#dbe4e1;--color-ink:#0f172a;--color-muted:#64748b;--color-accent:#d97706;--color-danger:#dc2626;--font-sans:'DM Sans','Segoe UI',ui-sans-serif,system-ui,sans-serif;\">\n    <header class=\"flex min-h-[64px] items-center gap-3 bg-[var(--color-primary)] px-5 py-3 text-white\" data-kid=\"1-1\" data-name=\"store header bar\">\n        <span aria-hidden=\"true\" class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/12 text-white\" data-kid=\"1-1-1\" data-name=\"store logo badge\">\n            <i class=\"icon-shopping-bag text-[20px]\" data-kid=\"1-1-1-1\" data-name=\"shopping bag logo icon\">\n            </i>\n        </span>\n        <div class=\"min-w-0\" data-kid=\"1-1-2\" data-name=\"store identity block\">\n            <p class=\"truncate text-[15px] font-bold leading-5 tracking-tight\" data-kid=\"1-1-2-1\" data-name=\"store name text\">\n                GHALaJ ENTERPRISE\n            </p>\n            <p class=\"text-[12px] leading-4 text-emerald-100\" data-kid=\"1-1-2-2\" data-name=\"store tagline text\">\n                Online shop\n            </p>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[520px] px-5 pb-8 pt-4\" data-kid=\"1-2\" data-name=\"main checkout content container\">\n        <button aria-label=\"Back to products\" class=\"-ml-2 inline-flex min-h-11 items-center gap-2 rounded-lg px-2 text-[14px] font-semibold text-[var(--color-primary)]\" data-kid=\"1-2-1\" data-name=\"back to products button\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"icon-arrow-left text-[18px]\" data-kid=\"1-2-1-1\" data-name=\"left arrow back icon\">\n            </i>\n            Back to products\n        </button>\n        <div class=\"mb-5 mt-1 flex items-end justify-between gap-3\" data-kid=\"1-2-2\" data-name=\"order review title row\">\n            <h1 class=\"text-[25px] font-bold leading-[1.16] tracking-[-0.03em] text-[var(--color-ink)]\" data-kid=\"1-2-2-1\" data-name=\"headline text\">\n                Review your order\n            </h1>\n            <span class=\"shrink-0 pb-0.5 text-[13px] font-medium tabular-nums text-[var(--color-muted)]\" data-kid=\"1-2-2-2\" data-name=\"item count label\">\n                1 item\n            </span>\n        </div>\n        <section aria-labelledby=\"order-heading\" data-kid=\"1-2-3\" data-name=\"order summary section\">\n            <h2 class=\"mb-3 text-[15px] font-bold text-[var(--color-ink)]\" data-kid=\"1-2-3-1\" data-name=\"order summary heading\" id=\"order-heading\">\n                Order summary\n            </h2>\n            <div class=\"border-y border-[var(--color-border)] py-3\" data-kid=\"1-2-3-2\" data-name=\"order item row block\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-2-3-2-1\" data-name=\"order item content row\">\n                    <div aria-label=\"No product photo\" class=\"flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-[var(--color-surface-muted)] text-[var(--color-primary)]\" data-kid=\"1-2-3-2-1-1\" data-name=\"product photo placeholder\" role=\"img\">\n                        <i aria-hidden=\"true\" class=\"icon-package text-[24px]\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"package placeholder icon\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-2-3-2-1-2\" data-name=\"product details column\">\n                        <p class=\"break-words text-[15px] font-semibold leading-5 text-[var(--color-ink)]\" data-kid=\"1-2-3-2-1-2-1\" data-name=\"product name text\">\n                            Machine oil\n                        </p>\n                        <p class=\"mt-1 text-[13px] leading-4 text-[var(--color-muted)]\" data-kid=\"1-2-3-2-1-2-2\" data-name=\"product category text\">\n                            Electronics\n                        </p>\n                        <p class=\"mt-1.5 text-[14px] font-semibold tabular-nums text-[var(--color-primary)]\" data-kid=\"1-2-3-2-1-2-3\" data-name=\"unit price text\">\n                            GH₵12.00\n                            <span class=\"font-normal text-[var(--color-muted)]\" data-kid=\"1-2-3-2-1-2-3-1\" data-name=\"per-unit price suffix\">\n                                each\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-3 flex items-center justify-between gap-3 border-t border-[var(--color-border)] pt-3\" data-kid=\"1-2-3-2-2\" data-name=\"quantity control row\">\n                    <span class=\"text-[13px] font-medium text-[var(--color-muted)]\" data-kid=\"1-2-3-2-2-1\" data-name=\"quantity label\">\n                        Quantity\n                    </span>\n                    <div aria-label=\"Quantity controls\" class=\"flex items-center gap-1.5\" data-kid=\"1-2-3-2-2-2\" data-name=\"quantity controls container\">\n                        <button aria-label=\"Decrease quantity\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--color-border)] bg-white text-[var(--color-ink)]\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"decrease quantity button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon-minus text-[17px]\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"minus icon\">\n                            </i>\n                        </button>\n                        <span aria-label=\"Quantity 1\" class=\"flex h-11 min-w-10 items-center justify-center px-2 text-[15px] font-bold tabular-nums text-[var(--color-ink)]\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"quantity value display\">\n                            1\n                        </span>\n                        <button aria-label=\"Increase quantity\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-[var(--color-border)] bg-white text-[var(--color-primary)]\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"increase quantity button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon-plus text-[17px]\" data-kid=\"1-2-3-2-2-2-3-1\" data-name=\"plus icon\">\n                            </i>\n                        </button>\n                        <button aria-label=\"Remove Machine oil from order\" class=\"ml-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-[var(--color-muted)]\" data-kid=\"1-2-3-2-2-2-4\" data-name=\"remove from order button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon-trash-2 text-[18px]\" data-kid=\"1-2-3-2-2-2-4-1\" data-name=\"trash icon\">\n                            </i>\n                        </button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-baseline justify-between gap-3 py-3.5\" data-kid=\"1-2-3-3\" data-name=\"product total row\">\n                <div data-kid=\"1-2-3-3-1\" data-name=\"product total label group\">\n                    <p class=\"text-[14px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-3-3-1-1\" data-name=\"product total label\">\n                        Product total\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] text-[var(--color-muted)]\" data-kid=\"1-2-3-3-1-2\" data-name=\"item count sublabel\">\n                        1 item\n                    </p>\n                </div>\n                <p class=\"text-[20px] font-bold tracking-tight tabular-nums text-[var(--color-primary)]\" data-kid=\"1-2-3-3-2\" data-name=\"product total amount\">\n                    GH₵12.00\n                </p>\n            </div>\n            <div class=\"flex items-start gap-3 border-t border-[var(--color-border)] py-3\" data-kid=\"1-2-3-4\" data-name=\"delivery charge row\">\n                <i aria-hidden=\"true\" class=\"icon-map-pin mt-0.5 text-[18px] text-[var(--color-primary)]\" data-kid=\"1-2-3-4-1\" data-name=\"map pin icon\">\n                </i>\n                <div data-kid=\"1-2-3-4-2\" data-name=\"delivery charge text group\">\n                    <p class=\"text-[13px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-3-4-2-1\" data-name=\"delivery charge label\">\n                        Delivery charge\n                    </p>\n                    <p class=\"mt-0.5 text-[13px] leading-[1.45] text-[var(--color-muted)]\" data-kid=\"1-2-3-4-2-2\" data-name=\"delivery charge description\">\n                        Any applicable charge is confirmed by the store.\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex min-h-12 items-center justify-between gap-3 border-y border-[var(--color-border)] py-2.5\" data-kid=\"1-2-3-5\" data-name=\"payment method row\">\n                <span class=\"text-[13px] font-medium text-[var(--color-muted)]\" data-kid=\"1-2-3-5-1\" data-name=\"payment label\">\n                    Payment\n                </span>\n                <span class=\"inline-flex min-h-9 items-center gap-2 rounded-lg bg-[var(--color-primary-subtle)] px-3 text-[13px] font-semibold text-[var(--color-primary-dark)]\" data-kid=\"1-2-3-5-2\" data-name=\"payment method badge\">\n                    <i aria-hidden=\"true\" class=\"icon-wallet text-[16px]\" data-kid=\"1-2-3-5-2-1\" data-name=\"wallet icon\">\n                    </i>\n                    Pay on delivery\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"delivery-heading\" class=\"mt-6\" data-kid=\"1-2-4\" data-name=\"delivery details section\">\n            <div class=\"mb-3\" data-kid=\"1-2-4-1\" data-name=\"delivery details header block\">\n                <h2 class=\"text-[18px] font-bold leading-6 tracking-[-0.02em] text-[var(--color-ink)]\" data-kid=\"1-2-4-1-1\" data-name=\"delivery details heading\" id=\"delivery-heading\">\n                    Delivery details\n                </h2>\n                <p class=\"mt-0.5 text-[13px] leading-5 text-[var(--color-muted)]\" data-kid=\"1-2-4-1-2\" data-name=\"delivery details subtext\">\n                    The store will confirm availability and delivery arrangements.\n                </p>\n            </div>\n            <form class=\"space-y-3\" data-kid=\"1-2-4-2\" data-name=\"delivery details form\">\n                <label class=\"block\" data-kid=\"1-2-4-2-1\" data-name=\"full name field label\">\n                    <span class=\"mb-1.5 block text-[14px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-4-2-1-1\" data-name=\"full name label text\">\n                        Full name\n                    </span>\n                    <input autocomplete=\"name\" class=\"h-12 w-full rounded-xl border border-[var(--color-border)] bg-white px-3.5 text-[16px] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-light)]/30\" data-kid=\"1-2-4-2-1-2\" data-name=\"full name input field\" placeholder=\"Enter your full name\" type=\"text\"/>\n                </label>\n                <label class=\"block\" data-kid=\"1-2-4-2-2\" data-name=\"phone field label\">\n                    <span class=\"mb-1.5 block text-[14px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-4-2-2-1\" data-name=\"phone label text\">\n                        Phone\n                    </span>\n                    <input autocomplete=\"tel\" class=\"h-12 w-full rounded-xl border border-[var(--color-border)] bg-white px-3.5 text-[16px] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-light)]/30\" data-kid=\"1-2-4-2-2-2\" data-name=\"phone number input field\" inputmode=\"tel\" placeholder=\"Enter your phone number\" type=\"tel\"/>\n                </label>\n                <label class=\"block\" data-kid=\"1-2-4-2-3\" data-name=\"delivery address field label\">\n                    <span class=\"mb-1.5 block text-[14px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-4-2-3-1\" data-name=\"delivery address label text\">\n                        Delivery address\n                    </span>\n                    <textarea class=\"min-h-[72px] w-full resize-y rounded-xl border border-[var(--color-border)] bg-white px-3.5 py-3 text-[16px] leading-5 text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-light)]/30\" data-kid=\"1-2-4-2-3-2\" data-name=\"delivery address textarea\" placeholder=\"Where should we deliver?\" rows=\"2\"></textarea>\n                </label>\n                <label class=\"block\" data-kid=\"1-2-4-2-4\" data-name=\"notes field label\">\n                    <span class=\"mb-1.5 block text-[14px] font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-4-2-4-1\" data-name=\"notes label text\">\n                        Notes\n                        <span class=\"font-normal text-[var(--color-muted)]\" data-kid=\"1-2-4-2-4-1-1\" data-name=\"optional tag\">\n                            (optional)\n                        </span>\n                    </span>\n                    <input class=\"h-12 w-full rounded-xl border border-[var(--color-border)] bg-white px-3.5 text-[16px] text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:border-[var(--color-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-light)]/30\" data-kid=\"1-2-4-2-4-2\" data-name=\"notes input field\" placeholder=\"Special instructions\" type=\"text\"/>\n                </label>\n            </form>\n            <button class=\"mt-4 flex min-h-14 w-full items-center justify-center gap-2 rounded-xl bg-[var(--color-primary)] px-5 text-[16px] font-bold text-white shadow-sm\" data-kid=\"1-2-4-3\" data-name=\"place order button\" type=\"button\">\n                Place order\n                <i aria-hidden=\"true\" class=\"icon-arrow-right text-[18px]\" data-kid=\"1-2-4-3-1\" data-name=\"right arrow icon\">\n                </i>\n            </button>\n            <p class=\"mx-auto mt-3 max-w-[320px] text-center text-[12px] leading-[1.5] text-[var(--color-muted)]\" data-kid=\"1-2-4-4\" data-name=\"store confirmation notice text\">\n                The store will confirm delivery details, any applicable charge and payment arrangements.\n            </p>\n            <div class=\"mt-5 flex items-center justify-center gap-4 border-t border-[var(--color-border)] pt-4 text-[12px] text-[var(--color-muted)]\" data-kid=\"1-2-4-5\" data-name=\"footer links row\">\n                <a class=\"min-h-11 inline-flex items-center font-semibold text-[var(--color-primary)]\" data-kid=\"1-2-4-5-1\" data-name=\"terms and conditions link\" href=\"#/terms\">\n                    Terms & conditions\n                </a>\n                <span aria-hidden=\"true\" data-kid=\"1-2-4-5-2\" data-name=\"separator dot\">\n                    ·\n                </span>\n                <span data-kid=\"1-2-4-5-3\" data-name=\"powered by brand text\">\n                    Powered by Adimat\n                </span>\n            </div>\n        </section>\n    </main>\n</div>\n",
      "comments": [],
      "created": "2026-10-20T10:17:28.513894+00:00",
      "modified": "2026-10-20T10:17:45.376304+00:00",
