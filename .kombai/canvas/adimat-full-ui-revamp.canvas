    "var_72c1428b5090": {
      "type": "variant",
      "label": "Store access · desktop",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1177.689144736842,
        "y": -50.986842105263165,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root {\n  --color-primary: #065f46;\n  --color-primary-light: #059669;\n  --color-primary-dark: #064e3b;\n  --color-primary-subtle: #ecfdf5;\n  --color-surface: #f8fafc;\n  --color-surface-muted: #f1f5f4;\n  --color-surface-card: #ffffff;\n  --color-border: #dbe4e1;\n  --color-ink: #0f172a;\n  --color-muted: #64748b;\n}\n</style>\n<main class=\"min-h-screen bg-[var(--color-surface-muted)] p-6 text-[var(--color-ink)]\" data-kid=\"1\" data-name=\"auth page layout container\" style=\"font-family:'DM Sans','Segoe UI',sans-serif\">\n    <div class=\"grid min-h-[840px] w-full grid-cols-[minmax(0,1.34fr)_minmax(500px,0.9fr)] gap-6\" data-kid=\"1-1\" data-name=\"two-column auth grid\">\n        <section class=\"flex min-w-0 flex-col justify-between rounded-[32px] border border-[var(--color-border)] bg-[var(--color-surface-card)] px-12 py-10 shadow-sm\" data-kid=\"1-1-1\" data-name=\"brand and feature info panel\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand header row\">\n                <span class=\"grid h-14 w-14 shrink-0 place-items-center overflow-hidden rounded-2xl border border-[var(--color-border)] bg-white\" data-kid=\"1-1-1-1-1\" data-name=\"logo image container\">\n                    <img alt=\"Adimat\" class=\"h-10 w-10 object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"Adimat logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo.png\"/>\n                </span>\n                <span class=\"flex flex-col\" data-kid=\"1-1-1-1-2\" data-name=\"brand name and tagline block\">\n                    <span class=\"text-[17px] font-bold leading-tight text-[var(--color-primary-dark)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        Adimat\n                    </span>\n                    <span class=\"mt-1 text-[11px] font-semibold uppercase tracking-[0.11em] text-[var(--color-muted)]\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline text\">\n                        Store operations\n                    </span>\n                </span>\n            </div>\n            <div class=\"max-w-[690px] py-12\" data-kid=\"1-1-1-2\" data-name=\"hero copy block\">\n                <p class=\"mb-5 text-[12px] font-bold uppercase tracking-[0.15em] text-[var(--color-primary-light)]\" data-kid=\"1-1-1-2-1\" data-name=\"hero eyebrow label false\">\n                    Store setup\n                </p>\n                <h1 class=\"max-w-[14ch] text-[52px] font-bold leading-[1.06] tracking-[-0.045em] text-[var(--color-primary-dark)]\" data-kid=\"1-1-1-2-2\" data-name=\"hero headline text\">\n                    Reconnect your store and carry on.\n                </h1>\n                <p class=\"mt-6 max-w-[42rem] text-[17px] leading-[1.65] text-slate-600\" data-kid=\"1-1-1-2-3\" data-name=\"hero descriptive paragraph\">\n                    Restore your synced workspace with the Store ID and owner PIN set by your administrator.\n                </p>\n            </div>\n            <div data-kid=\"1-1-1-3\" data-name=\"feature highlights area\">\n                <div class=\"grid grid-cols-3 divide-x divide-[var(--color-border)] border-y border-[var(--color-border)] py-5\" data-kid=\"1-1-1-3-1\" data-name=\"three-column feature strip\">\n                    <div class=\"pr-6\" data-kid=\"1-1-1-3-1-1\" data-name=\"feature item for point of sale\">\n                        <h2 class=\"text-[14px] font-bold text-[var(--color-ink)]\" data-kid=\"1-1-1-3-1-1-1\" data-name=\"feature item title\">\n                            Point of sale\n                        </h2>\n                        <p class=\"mt-1.5 text-[13px] leading-5 text-[var(--color-muted)]\" data-kid=\"1-1-1-3-1-1-2\" data-name=\"feature item description\">\n                            Move from products to payment.\n                        </p>\n                    </div>\n                    <div class=\"px-6\" data-kid=\"1-1-1-3-1-2\" data-name=\"feature item for inventory\">\n                        <h2 class=\"text-[14px] font-bold text-[var(--color-ink)]\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"feature item title\">\n                            Inventory\n                        </h2>\n                        <p class=\"mt-1.5 text-[13px] leading-5 text-[var(--color-muted)]\" data-kid=\"1-1-1-3-1-2-2\" data-name=\"feature item description\">\n                            Know what is in stock and where.\n                        </p>\n                    </div>\n                    <div class=\"pl-6\" data-kid=\"1-1-1-3-1-3\" data-name=\"feature item for reports\">\n                        <h2 class=\"text-[14px] font-bold text-[var(--color-ink)]\" data-kid=\"1-1-1-3-1-3-1\" data-name=\"feature item title\">\n                            Reports\n                        </h2>\n                        <p class=\"mt-1.5 text-[13px] leading-5 text-[var(--color-muted)]\" data-kid=\"1-1-1-3-1-3-2\" data-name=\"feature item description\">\n                            See sales and trends at a glance.\n                        </p>\n                    </div>\n                </div>\n                <p class=\"mt-5 text-[13px] font-medium text-[var(--color-muted)]\" data-kid=\"1-1-1-3-2\" data-name=\"feature section footer line\">\n                    Built for the work of running a store.\n                </p>\n            </div>\n        </section>\n        <section class=\"flex min-w-0 flex-col rounded-[32px] bg-[linear-gradient(150deg,var(--color-primary-dark),var(--color-primary))] p-9 text-white shadow-[0_28px_64px_-38px_rgba(6,78,59,0.5)]\" data-kid=\"1-1-2\" data-name=\"store login panel with gradient background\">\n            <div class=\"flex items-center justify-between gap-4\" data-kid=\"1-1-2-1\" data-name=\"login panel header row\">\n                <div class=\"min-w-0\" data-kid=\"1-1-2-1-1\" data-name=\"login panel header text block\">\n                    <p class=\"text-[12px] font-semibold text-emerald-100/90\" data-kid=\"1-1-2-1-1-1\" data-name=\"login panel brand label\">\n                        Adimat\n                    </p>\n                    <p class=\"mt-1 text-[13px] text-emerald-100/75\" data-kid=\"1-1-2-1-1-2\" data-name=\"login panel instruction text\">\n                        Open the store your administrator created\n                    </p>\n                </div>\n                <div aria-label=\"Choose language\" class=\"flex w-[206px] shrink-0 gap-1 rounded-xl border border-white/20 bg-white/10 p-1\" data-kid=\"1-1-2-1-2\" data-name=\"language toggle group\" role=\"group\">\n                    <button aria-pressed=\"true\" class=\"min-h-11 flex-1 rounded-lg bg-white px-3 text-[13px] font-semibold text-[var(--color-primary)] shadow-sm\" data-kid=\"1-1-2-1-2-1\" data-name=\"English language button\" type=\"button\">\n                        English\n                    </button>\n                    <button aria-pressed=\"false\" class=\"min-h-11 flex-1 rounded-lg px-3 text-[13px] font-semibold text-white/90\" data-kid=\"1-1-2-1-2-2\" data-name=\"Français language button\" type=\"button\">\n                        Français\n                    </button>\n                </div>\n            </div>\n            <div class=\"my-auto flex justify-center py-8\" data-kid=\"1-1-2-2\" data-name=\"login form wrapper\">\n                <form class=\"w-full max-w-[450px] rounded-[24px] bg-[var(--color-surface-card)] p-8 text-[var(--color-ink)] shadow-xl\" data-kid=\"1-1-2-2-1\" data-name=\"store login form card\" onsubmit=\"return false;\">\n                    <div data-kid=\"1-1-2-2-1-1\" data-name=\"form heading and help text block\">\n                        <h2 class=\"text-[20px] font-bold tracking-[-0.02em] text-[var(--color-ink)]\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"form heading text\">\n                            Open your store\n                        </h2>\n                        <p class=\"mt-2 text-[13px] leading-[1.55] text-slate-600\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"form help text\">\n                            Ask the Adimat administrator\n                            <span class=\"whitespace-nowrap font-semibold text-slate-700\" data-kid=\"1-1-2-2-1-1-2-1\" data-name=\"administrator contact phone number\">\n                                +233-555-857-224\n                            </span>\n                            for the Store ID and the owner PIN they set for you.\n                        </p>\n                    </div>\n                    <div class=\"mt-7\" data-kid=\"1-1-2-2-1-2\" data-name=\"Store ID input group\">\n                        <label class=\"mb-2 block text-[14px] font-semibold text-slate-800\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"Store ID field label\" for=\"store-id\">\n                            Store ID\n                        </label>\n                        <input autocapitalize=\"off\" autocomplete=\"off\" class=\"h-[54px] w-full rounded-xl border-2 border-[var(--color-primary)] bg-white px-4 font-mono text-[14px] text-slate-900 outline-none ring-4 ring-emerald-100 placeholder:font-sans placeholder:text-slate-400 focus:border-[var(--color-primary-dark)] focus:ring-[var(--color-primary-light)]/20\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"Store ID text input\" id=\"store-id\" placeholder=\"Paste your Store ID\" required=\"\" type=\"text\"/>\n                    </div>\n                    <div class=\"mt-5\" data-kid=\"1-1-2-2-1-3\" data-name=\"owner PIN input group\">\n                        <label class=\"mb-2 flex items-center justify-between gap-3 text-[14px] font-semibold text-slate-800\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"owner PIN field label\" for=\"owner-pin\">\n                            <span data-kid=\"1-1-2-2-1-3-1-1\" data-name=\"owner PIN label text\">\n                                Owner PIN\n                            </span>\n                            <span class=\"text-[12px] font-medium text-slate-500\" data-kid=\"1-1-2-2-1-3-1-2\" data-name=\"owner PIN digit hint\">\n                                4 digits\n                            </span>\n                        </label>\n                        <input autocomplete=\"off\" class=\"h-[54px] w-full rounded-xl border border-slate-300 bg-white px-4 text-center text-[18px] font-semibold tracking-[0.55em] text-slate-700 outline-none placeholder:text-slate-400 focus:border-[var(--color-primary)] focus:ring-4 focus:ring-emerald-100\" data-kid=\"1-1-2-2-1-3-2\" data-name=\"owner PIN password input\" id=\"owner-pin\" inputmode=\"numeric\" maxlength=\"4\" placeholder=\"••••\" required=\"\" type=\"password\"/>\n                    </div>\n                    <button class=\"mt-6 flex min-h-14 w-full items-center justify-center gap-2.5 rounded-xl bg-[var(--color-primary)] px-5 text-[15px] font-bold text-white shadow-sm hover:bg-[var(--color-primary-dark)] focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-primary-light)]\" data-kid=\"1-1-2-2-1-4\" data-name=\"open store submit button\" type=\"submit\">\n                        <i aria-hidden=\"true\" class=\"icon-cloud-download text-[18px]\" data-kid=\"1-1-2-2-1-4-1\" data-name=\"cloud download icon\">\n                        </i>\n                        Open store\n                    </button>\n                    <div class=\"mt-5 border-t border-slate-200 pt-3\" data-kid=\"1-1-2-2-1-5\" data-name=\"secondary actions group\">\n                        <button class=\"flex min-h-11 w-full items-center justify-center gap-2 rounded-lg px-3 text-[14px] font-semibold text-[var(--color-primary-dark)] hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary-light)]\" data-kid=\"1-1-2-2-1-5-1\" data-name=\"administrator portal button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon-shield text-[16px]\" data-kid=\"1-1-2-2-1-5-1-1\" data-name=\"shield icon\">\n                            </i>\n                            Administrator portal\n                        </button>\n                        <button class=\"mt-1 flex min-h-11 w-full items-center justify-center gap-2 rounded-lg px-3 text-[14px] font-semibold text-[var(--color-primary-dark)] hover:bg-emerald-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary-light)]\" data-kid=\"1-1-2-2-1-5-2\" data-name=\"join community chat button\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"icon-message-square text-[16px]\" data-kid=\"1-1-2-2-1-5-2-1\" data-name=\"message square icon\">\n                            </i>\n                            Join community chat\n                        </button>\n                    </div>\n                </form>\n            </div>\n        </section>\n    </div>\n</main>\n",
      "comments": [],
      "created": "2026-10-20T10:17:33.825446+00:00",
      "modified": "2026-10-20T10:17:46.330196+00:00",
      "id": "var_72c1428b5090",
      "contentHeight": 1000
    },
    "var_8250545fcd19": {
      "type": "variant",
      "label": "Cashier POS · mobile",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4060,
        "y": 0,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"mx-auto flex h-[100svh] min-h-[680px] max-h-[100svh] w-full max-w-[390px] flex-col overflow-hidden bg-[var(--color-surface)] text-[var(--color-ink)]\" data-kid=\"1\" data-name=\"mobile POS app layout container\" style=\"--color-primary:#065f46; --color-primary-light:#059669; --color-primary-dark:#064e3b; --color-primary-subtle:#ecfdf5; --color-accent:#d97706; --color-surface:#f8fafc; --color-surface-card:#ffffff; --color-surface-muted:#f1f5f4; --color-border:#dbe4e1; --color-ink:#0f172a; --color-muted:#64748b; font-family:'DM Sans', 'Segoe UI', ui-sans-serif, system-ui, sans-serif;\">\n    <header class=\"z-20 flex h-[58px] shrink-0 items-center justify-between bg-[var(--color-primary)] px-4 text-white\" data-kid=\"1-1\" data-name=\"app header bar\">\n        <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1\" data-name=\"app brand identity group\">\n            <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-white/15 text-xl text-white\" data-kid=\"1-1-1-1\" data-name=\"brand logo badge\">\n                <i aria-hidden=\"true\" class=\"icon-scan-line h-5 w-5\" data-kid=\"1-1-1-1-1\" data-name=\"scan line logo icon\">\n                </i>\n            </span>\n            <div class=\"min-w-0\" data-kid=\"1-1-1-2\" data-name=\"brand name group\">\n                <h1 class=\"text-lg font-bold leading-tight\" data-kid=\"1-1-1-2-1\" data-name=\"brand name headline\">\n                    POS\n                </h1>\n                <p class=\"text-sm leading-4 text-emerald-100\" data-kid=\"1-1-1-2-2\" data-name=\"brand tagline text\">\n                    Store checkout\n                </p>\n            </div>\n        </div>\n        <button aria-label=\"Open scanner\" class=\"flex h-11 min-w-11 items-center justify-center rounded-xl bg-white/15 px-3 text-sm font-semibold text-white\" data-kid=\"1-1-2\" data-name=\"open scanner button\">\n            <i aria-hidden=\"true\" class=\"icon-scan-barcode mr-2 h-5 w-5 text-xl\" data-kid=\"1-1-2-1\" data-name=\"scan barcode icon\">\n            </i>\n            <span data-kid=\"1-1-2-2\" data-name=\"scan button label\">\n                Scan\n            </span>\n        </button>\n    </header>\n    <main class=\"min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 pb-[calc(168px+env(safe-area-inset-bottom))] pt-3\" data-kid=\"1-2\" data-name=\"scrollable POS main content\">\n        <section aria-label=\"Current store inventory\" class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"1-2-1\" data-name=\"stock location selector row\">\n            <div class=\"min-w-0\" data-kid=\"1-2-1-1\" data-name=\"stock location label group\">\n                <p class=\"text-sm font-medium text-[var(--color-muted)]\" data-kid=\"1-2-1-1-1\" data-name=\"stock location caption\">\n                    Stock from\n                </p>\n                <button aria-label=\"Select stock location\" class=\"flex min-h-11 items-center gap-1 text-base font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-1-1-2\" data-name=\"current location dropdown button\">\n                    Current store\n                    <i aria-hidden=\"true\" class=\"icon-chevron-down h-4 w-4 text-lg text-[var(--color-muted)]\" data-kid=\"1-2-1-1-2-1\" data-name=\"chevron down icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2 rounded-xl bg-[var(--color-primary-subtle)] px-3 py-2 text-sm font-semibold text-[var(--color-primary)]\" data-kid=\"1-2-1-2\" data-name=\"location badge chip\">\n                <i aria-hidden=\"true\" class=\"icon-store h-4 w-4 text-base\" data-kid=\"1-2-1-2-1\" data-name=\"store building icon\">\n                </i>\n                <span data-kid=\"1-2-1-2-2\" data-name=\"location badge text\">\n                    Retail · Unit\n                </span>\n            </div>\n        </section>\n        <div class=\"mb-3 flex gap-2\" data-kid=\"1-2-2\" data-name=\"search and scan row\">\n            <label class=\"flex min-h-12 min-w-0 flex-1 items-center gap-2 rounded-xl border border-[var(--color-border)] bg-white px-3.5 text-[var(--color-muted)] focus-within:border-[var(--color-primary)] focus-within:ring-2 focus-within:ring-emerald-100\" data-kid=\"1-2-2-1\" data-name=\"product search input group\">\n                <i aria-hidden=\"true\" class=\"icon-search h-5 w-5 shrink-0 text-xl\" data-kid=\"1-2-2-1-1\" data-name=\"search magnifier icon\">\n                </i>\n                <input aria-label=\"Search products or scan barcode\" class=\"min-w-0 flex-1 border-0 bg-transparent p-0 text-base text-[var(--color-ink)] placeholder:text-[var(--color-muted)] focus:outline-none\" data-kid=\"1-2-2-1-2\" data-name=\"product search input field\" placeholder=\"Search or scan barcode\"/>\n            </label>\n            <button aria-label=\"Use camera scanner\" class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-[var(--color-border)] bg-white text-[var(--color-primary)]\" data-kid=\"1-2-2-2\" data-name=\"camera scanner button\">\n                <i aria-hidden=\"true\" class=\"icon-camera h-5 w-5 text-xl\" data-kid=\"1-2-2-2-1\" data-name=\"camera icon\">\n                </i>\n            </button>\n        </div>\n        <section aria-label=\"Sale pricing options\" class=\"mb-4 flex items-end justify-between gap-3\" data-kid=\"1-2-3\" data-name=\"sale pricing options row\">\n            <div data-kid=\"1-2-3-1\" data-name=\"price type selector group\">\n                <p class=\"mb-1 text-sm font-semibold text-[var(--color-muted)]\" data-kid=\"1-2-3-1-1\" data-name=\"price type label\">\n                    Price\n                </p>\n                <div class=\"inline-flex h-11 rounded-xl bg-[var(--color-surface-muted)] p-1\" data-kid=\"1-2-3-1-2\" data-name=\"price type segmented control\">\n                    <button aria-pressed=\"true\" class=\"min-w-[66px] rounded-lg bg-white px-3 text-sm font-bold text-[var(--color-primary)] shadow-xs\" data-kid=\"1-2-3-1-2-1\" data-name=\"retail price toggle button\">\n                        Retail\n                    </button>\n                    <button aria-pressed=\"false\" class=\"min-w-[78px] rounded-lg px-3 text-sm font-medium text-[var(--color-muted)]\" data-kid=\"1-2-3-1-2-2\" data-name=\"wholesale price toggle button\">\n                        Wholesale\n                    </button>\n                </div>\n            </div>\n            <div data-kid=\"1-2-3-2\" data-name=\"sell unit selector group\">\n                <p class=\"mb-1 text-sm font-semibold text-[var(--color-muted)]\" data-kid=\"1-2-3-2-1\" data-name=\"sell unit label\">\n                    Sell as\n                </p>\n                <div class=\"inline-flex h-11 rounded-xl bg-[var(--color-surface-muted)] p-1\" data-kid=\"1-2-3-2-2\" data-name=\"sell unit segmented control\">\n                    <button aria-pressed=\"true\" class=\"min-w-[52px] rounded-lg bg-white px-3 text-sm font-bold text-[var(--color-primary)] shadow-xs\" data-kid=\"1-2-3-2-2-1\" data-name=\"unit sale toggle button\">\n                        Unit\n                    </button>\n                    <button aria-pressed=\"false\" class=\"min-w-[52px] rounded-lg px-3 text-sm font-medium text-[var(--color-muted)]\" data-kid=\"1-2-3-2-2-2\" data-name=\"pack sale toggle button\">\n                        Pack\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Current sale\" class=\"mb-4 border-y border-[var(--color-border)] bg-white\" data-kid=\"1-2-4\" data-name=\"current sale cart section\">\n            <div class=\"flex min-h-14 items-center justify-between gap-2 px-3\" data-kid=\"1-2-4-1\" data-name=\"current sale header row\">\n                <div class=\"min-w-0\" data-kid=\"1-2-4-1-1\" data-name=\"current sale title group\">\n                    <h2 class=\"text-base font-bold text-[var(--color-ink)]\" data-kid=\"1-2-4-1-1-1\" data-name=\"current sale title\">\n                        Current sale\n                    </h2>\n                    <p class=\"text-sm text-[var(--color-muted)]\" data-kid=\"1-2-4-1-1-2\" data-name=\"current sale item count\">\n                        3 items\n                    </p>\n                </div>\n                <div class=\"flex shrink-0 items-center gap-1\" data-kid=\"1-2-4-1-2\" data-name=\"current sale actions group\">\n                    <button aria-label=\"Hold current sale\" class=\"flex min-h-11 items-center gap-1 rounded-lg px-2 text-sm font-semibold text-[var(--color-primary)]\" data-kid=\"1-2-4-1-2-1\" data-name=\"hold sale button\">\n                        <i aria-hidden=\"true\" class=\"icon-pause h-4 w-4 text-base\" data-kid=\"1-2-4-1-2-1-1\" data-name=\"pause icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-1-2-1-2\" data-name=\"hold button label\">\n                            Hold\n                        </span>\n                    </button>\n                    <button aria-label=\"View held sales\" class=\"flex min-h-11 items-center gap-1 rounded-lg px-2 text-sm font-semibold text-[var(--color-primary)]\" data-kid=\"1-2-4-1-2-2\" data-name=\"view held sales button\">\n                        <i aria-hidden=\"true\" class=\"icon-clock-3 h-4 w-4 text-base\" data-kid=\"1-2-4-1-2-2-1\" data-name=\"clock icon\">\n                        </i>\n                        <span data-kid=\"1-2-4-1-2-2-2\" data-name=\"held sales button label\">\n                            Held sales\n                        </span>\n                    </button>\n                </div>\n            </div>\n            <div class=\"mx-3 border-t border-[var(--color-border)]\" data-kid=\"1-2-4-2\" data-name=\"sale items list container\">\n                <div class=\"flex min-h-[58px] items-center justify-between gap-3 border-b border-[var(--color-border)] py-2.5\" data-kid=\"1-2-4-2-1\" data-name=\"sale line item row\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-4-2-1-1\" data-name=\"line item name group\">\n                        <p class=\"truncate text-base font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-4-2-1-1-1\" data-name=\"line item product name\">\n                            machine oil\n                        </p>\n                        <p class=\"text-sm text-[var(--color-muted)]\" data-kid=\"1-2-4-2-1-1-2\" data-name=\"line item quantity and unit price\">\n                            2 × GH₵12.00\n                        </p>\n                    </div>\n                    <p class=\"shrink-0 text-base font-bold tabular-nums text-[var(--color-ink)]\" data-kid=\"1-2-4-2-1-2\" data-name=\"line item line total price\">\n                        GH₵24.00\n                    </p>\n                </div>\n                <div class=\"flex min-h-[58px] items-center justify-between gap-3 py-2.5\" data-kid=\"1-2-4-2-2\" data-name=\"sale line item row\">\n                    <div class=\"min-w-0\" data-kid=\"1-2-4-2-2-1\" data-name=\"line item name group\">\n                        <p class=\"truncate text-base font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"line item product name\">\n                            P K GARLIC MIXTURE\n                        </p>\n                        <p class=\"text-sm text-[var(--color-muted)]\" data-kid=\"1-2-4-2-2-1-2\" data-name=\"line item quantity and unit price\">\n                            1 × GH₵45.00\n                        </p>\n                    </div>\n                    <p class=\"shrink-0 text-base font-bold tabular-nums text-[var(--color-ink)]\" data-kid=\"1-2-4-2-2-2\" data-name=\"line item line total price\">\n                        GH₵45.00\n                    </p>\n                </div>\n            </div>\n            <div class=\"flex items-center justify-between border-t border-[var(--color-border)] px-3 py-2.5\" data-kid=\"1-2-4-3\" data-name=\"current sale subtotal row\">\n                <p class=\"text-base font-semibold text-[var(--color-ink)]\" data-kid=\"1-2-4-3-1\" data-name=\"subtotal label\">\n                    Subtotal\n                </p>\n                <p class=\"text-lg font-bold tabular-nums text-[var(--color-primary)]\" data-kid=\"1-2-4-3-2\" data-name=\"subtotal amount\">\n                    GH₵69.00\n                </p>\n            </div>\n        </section>\n        <section aria-label=\"Product catalog\" data-kid=\"1-2-5\" data-name=\"product catalog section\">\n            <div class=\"mb-1 flex min-h-8 items-center justify-between gap-2\" data-kid=\"1-2-5-1\" data-name=\"product catalog header row\">\n                <h2 class=\"text-lg font-bold text-[var(--color-ink)]\" data-kid=\"1-2-5-1-1\" data-name=\"product catalog title\">\n                    Products\n                </h2>\n                <span class=\"text-sm text-[var(--color-muted)]\" data-kid=\"1-2-5-1-2\" data-name=\"stock source caption\">\n                    Sample stock\n                </span>\n            </div>\n            <div class=\"divide-y divide-[var(--color-border)] bg-white\" data-kid=\"1-2-5-2\" data-name=\"product list container\">\n                <article class=\"flex min-h-[72px] items-center gap-3 py-2.5\" data-kid=\"1-2-5-2-1\" data-name=\"product card row\">\n                    <span class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--color-surface-muted)] text-[var(--color-muted)]\" data-kid=\"1-2-5-2-1-1\" data-name=\"product image placeholder badge\">\n                        <i aria-label=\"No product photo\" class=\"icon-package h-5 w-5 text-xl\" data-kid=\"1-2-5-2-1-1-1\" data-name=\"package placeholder icon\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-5-2-1-2\" data-name=\"product details group\">\n                        <h3 class=\"text-base font-semibold leading-5 text-[var(--color-ink)]\" data-kid=\"1-2-5-2-1-2-1\" data-name=\"product name\">\n                            machine oil\n                        </h3>\n                        <p class=\"text-sm text-[var(--color-muted)]\" data-kid=\"1-2-5-2-1-2-2\" data-name=\"product stock count\">\n                            Stock 6\n                        </p>\n                    </div>\n                    <div class=\"shrink-0 text-right\" data-kid=\"1-2-5-2-1-3\" data-name=\"product price group\">\n                        <p class=\"text-base font-bold tabular-nums text-[var(--color-ink)]\" data-kid=\"1-2-5-2-1-3-1\" data-name=\"product price\">\n                            GH₵12.00\n                        </p>\n                    </div>\n                    <button aria-label=\"Add machine oil, GH₵12.00\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary-subtle)] text-[var(--color-primary)]\" data-kid=\"1-2-5-2-1-4\" data-name=\"add product to sale button\">\n                        <i aria-hidden=\"true\" class=\"icon-plus h-5 w-5 text-xl\" data-kid=\"1-2-5-2-1-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n                <article class=\"flex min-h-[72px] items-center gap-3 py-2.5\" data-kid=\"1-2-5-2-2\" data-name=\"product card row\">\n                    <span class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--color-surface-muted)] text-[var(--color-muted)]\" data-kid=\"1-2-5-2-2-1\" data-name=\"product image placeholder badge\">\n                        <i aria-label=\"No product photo\" class=\"icon-package h-5 w-5 text-xl\" data-kid=\"1-2-5-2-2-1-1\" data-name=\"package placeholder icon\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-5-2-2-2\" data-name=\"product details group\">\n                        <h3 class=\"text-base font-semibold leading-5 text-[var(--color-ink)]\" data-kid=\"1-2-5-2-2-2-1\" data-name=\"product name\">\n                            iron cable with top plug\n                        </h3>\n                        <p class=\"text-sm text-[var(--color-muted)]\" data-kid=\"1-2-5-2-2-2-2\" data-name=\"product stock count\">\n                            Stock 1\n                        </p>\n                    </div>\n                    <div class=\"shrink-0 text-right\" data-kid=\"1-2-5-2-2-3\" data-name=\"product price group\">\n                        <p class=\"text-base font-bold tabular-nums text-[var(--color-ink)]\" data-kid=\"1-2-5-2-2-3-1\" data-name=\"product price\">\n                            GH₵35.00\n                        </p>\n                    </div>\n                    <button aria-label=\"Add iron cable with top plug, GH₵35.00\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary-subtle)] text-[var(--color-primary)]\" data-kid=\"1-2-5-2-2-4\" data-name=\"add product to sale button\">\n                        <i aria-hidden=\"true\" class=\"icon-plus h-5 w-5 text-xl\" data-kid=\"1-2-5-2-2-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n                <article class=\"flex min-h-[72px] items-center gap-3 py-2.5\" data-kid=\"1-2-5-2-3\" data-name=\"product card row\">\n                    <span class=\"flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--color-surface-muted)] text-[var(--color-muted)]\" data-kid=\"1-2-5-2-3-1\" data-name=\"product image placeholder badge\">\n                        <i aria-label=\"No product photo\" class=\"icon-package h-5 w-5 text-xl\" data-kid=\"1-2-5-2-3-1-1\" data-name=\"package placeholder icon\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-5-2-3-2\" data-name=\"product details group\">\n                        <h3 class=\"text-base font-semibold leading-5 text-[var(--color-ink)]\" data-kid=\"1-2-5-2-3-2-1\" data-name=\"product name\">\n                            P K GARLIC MIXTURE\n                        </h3>\n                        <p class=\"text-sm text-[var(--color-muted)]\" data-kid=\"1-2-5-2-3-2-2\" data-name=\"product stock count\">\n                            Stock 7\n                        </p>\n                    </div>\n                    <div class=\"shrink-0 text-right\" data-kid=\"1-2-5-2-3-3\" data-name=\"product price group\">\n                        <p class=\"text-base font-bold tabular-nums text-[var(--color-ink)]\" data-kid=\"1-2-5-2-3-3-1\" data-name=\"product price\">\n                            GH₵45.00\n                        </p>\n                    </div>\n                    <button aria-label=\"Add P K GARLIC MIXTURE, GH₵45.00\" class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary-subtle)] text-[var(--color-primary)]\" data-kid=\"1-2-5-2-3-4\" data-name=\"add product to sale button\">\n                        <i aria-hidden=\"true\" class=\"icon-plus h-5 w-5 text-xl\" data-kid=\"1-2-5-2-3-4-1\" data-name=\"plus icon\">\n                        </i>\n                    </button>\n                </article>\n            </div>\n            <p class=\"pt-2 text-sm text-[var(--color-muted)]\" data-kid=\"1-2-5-3\" data-name=\"sample data disclaimer\">\n                Prices and stock shown are sample reference data.\n            </p>\n        </section>\n    </main>\n    <div class=\"fixed inset-x-0 bottom-[calc(68px+env(safe-area-inset-bottom))] z-30 mx-auto w-full max-w-[390px] border-t border-[var(--color-border)] bg-white px-4 py-2.5\" data-kid=\"1-3\" data-name=\"checkout bar container\">\n        <button aria-label=\"Continue to checkout, total GH₵69.00\" class=\"flex min-h-12 w-full items-center justify-between rounded-xl bg-[var(--color-primary)] px-4 text-white\" data-kid=\"1-3-1\" data-name=\"checkout button\">\n            <span class=\"flex items-center gap-2 text-base font-bold\" data-kid=\"1-3-1-1\" data-name=\"checkout label group\">\n                <i aria-hidden=\"true\" class=\"icon-arrow-right h-5 w-5 text-xl\" data-kid=\"1-3-1-1-1\" data-name=\"arrow right icon\">\n                </i>\n                Checkout\n            </span>\n            <span class=\"text-base font-bold tabular-nums\" data-kid=\"1-3-1-2\" data-name=\"checkout total amount\">\n                GH₵69.00\n            </span>\n        </button>\n    </div>\n    <nav aria-label=\"Main navigation\" class=\"fixed inset-x-0 bottom-0 z-40 mx-auto w-full max-w-[390px] border-t border-[var(--color-border)] bg-white pb-[calc(env(safe-area-inset-bottom)+0.25rem)] pt-1.5\" data-kid=\"1-4\" data-name=\"bottom main navigation\">\n        <div class=\"grid grid-cols-4 px-2\" data-kid=\"1-4-1\" data-name=\"navigation button grid\">\n            <button aria-current=\"page\" class=\"flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-xl bg-[var(--color-primary-subtle)] text-[var(--color-primary)]\" data-kid=\"1-4-1-1\" data-name=\"POS navigation button\">\n                <i aria-hidden=\"true\" class=\"icon-scan-line h-5 w-5 text-xl\" data-kid=\"1-4-1-1-1\" data-name=\"scan line nav icon\">\n                </i>\n                <span class=\"text-sm font-bold\" data-kid=\"1-4-1-1-2\" data-name=\"POS nav label\">\n                    POS\n                </span>\n            </button>\n            <button class=\"flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-xl text-[var(--color-muted)]\" data-kid=\"1-4-1-2\" data-name=\"my sales navigation button\">\n                <i aria-hidden=\"true\" class=\"icon-receipt h-5 w-5 text-xl\" data-kid=\"1-4-1-2-1\" data-name=\"receipt nav icon\">\n                </i>\n                <span class=\"text-sm font-medium\" data-kid=\"1-4-1-2-2\" data-name=\"my sales nav label\">\n                    My sales\n                </span>\n            </button>\n            <button class=\"flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-xl text-[var(--color-muted)]\" data-kid=\"1-4-1-3\" data-name=\"expenses navigation button\">\n                <i aria-hidden=\"true\" class=\"icon-wallet h-5 w-5 text-xl\" data-kid=\"1-4-1-3-1\" data-name=\"wallet nav icon\">\n                </i>\n                <span class=\"text-sm font-medium\" data-kid=\"1-4-1-3-2\" data-name=\"expenses nav label\">\n                    Expenses\n                </span>\n            </button>\n            <button class=\"flex min-h-12 flex-col items-center justify-center gap-0.5 rounded-xl text-[var(--color-muted)]\" data-kid=\"1-4-1-4\" data-name=\"more navigation button\">\n                <i aria-hidden=\"true\" class=\"icon-ellipsis h-5 w-5 text-xl\" data-kid=\"1-4-1-4-1\" data-name=\"ellipsis nav icon\">\n                </i>\n                <span class=\"text-sm font-medium\" data-kid=\"1-4-1-4-2\" data-name=\"more nav label\">\n                    More\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",
