tions ellipsis icon\">\n                                        </i>\n                                    </button>\n                                </div>\n                            </div>\n                            <div class=\"grid min-h-[73px] grid-cols-[minmax(0,1.65fr)_minmax(145px,0.68fr)_minmax(150px,0.7fr)_132px] items-center gap-4 px-5 py-3 hover:bg-emerald-50/25\" data-kid=\"1-1-2-2-1-4-3-5\" data-name=\"product row ever linier 1g2w\">\n                                <div class=\"flex min-w-0 items-center gap-3.5\" data-kid=\"1-1-2-2-1-4-3-5-1\" data-name=\"product cell with icon and text\">\n                                    <span class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--app-subtle)] text-slate-500\" data-kid=\"1-1-2-2-1-4-3-5-1-1\" data-name=\"product icon badge\">\n                                        <i aria-hidden=\"true\" class=\"icon-package text-[20px]\" data-kid=\"1-1-2-2-1-4-3-5-1-1-1\" data-name=\"product package icon\">\n                                        </i>\n                                    </span>\n                                    <div class=\"min-w-0\" data-kid=\"1-1-2-2-1-4-3-5-1-2\" data-name=\"product name wrapper\">\n                                        <p class=\"truncate text-[14px] font-semibold text-slate-900\" data-kid=\"1-1-2-2-1-4-3-5-1-2-1\" data-name=\"product name text\">\n                                            ever linier 1g2w\n                                        </p>\n                                        <p class=\"mt-1 text-[12px] text-[var(--app-muted)]\" data-kid=\"1-1-2-2-1-4-3-5-1-2-2\" data-name=\"product category text\">\n                                            Electronics\n                                        </p>\n                                    </div>\n                                </div>\n                                <p class=\"text-right text-[14px] font-semibold tabular-nums text-slate-900\" data-kid=\"1-1-2-2-1-4-3-5-2\" data-name=\"product price text\">\n                                    GH₵25.00\n                                </p>\n                                <div class=\"text-right\" data-kid=\"1-1-2-2-1-4-3-5-3\" data-name=\"product stock cell\">\n                                    <p class=\"text-[14px] font-semibold tabular-nums text-slate-900\" data-kid=\"1-1-2-2-1-4-3-5-3-1\" data-name=\"stock quantity text\">\n                                        8\n                                    </p>\n                                    <p class=\"mt-0.5 text-[11px] text-[var(--app-muted)]\" data-kid=\"1-1-2-2-1-4-3-5-3-2\" data-name=\"stock status label\">\n                                        in stock\n                                    </p>\n                                </div>\n                                <div class=\"flex items-center justify-end gap-1.5\" data-kid=\"1-1-2-2-1-4-3-5-4\" data-name=\"product row actions\">\n                                    <button class=\"flex h-10 items-center gap-1.5 rounded-lg px-2.5 text-[12px] font-semibold text-[var(--app-primary)]\" data-kid=\"1-1-2-2-1-4-3-5-4-1\" data-name=\"adjust stock button\" type=\"button\">\n                                        <i aria-hidden=\"true\" class=\"icon-boxes text-[15px]\" data-kid=\"1-1-2-2-1-4-3-5-4-1-1\" data-name=\"adjust stock boxes icon\">\n                                        </i>\n                                        <span data-kid=\"1-1-2-2-1-4-3-5-4-1-2\" data-name=\"adjust stock button label\">\n                                            Adjust\n                                        </span>\n                                    </button>\n                                    <button aria-label=\"More actions for ever linier 1g2w\" class=\"flex h-10 w-10 items-center justify-center rounded-lg text-slate-400\" data-kid=\"1-1-2-2-1-4-3-5-4-2\" data-name=\"more actions button\" type=\"button\">\n                                        <i aria-hidden=\"true\" class=\"icon-ellipsis text-[18px]\" data-kid=\"1-1-2-2-1-4-3-5-4-2-1\" data-name=\"more actions ellipsis icon\">\n                                        </i>\n                                    </button>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"flex min-h-[54px] flex-wrap items-center justify-between gap-2 border-t border-[var(--app-border)] bg-slate-50/60 px-5 py-3\" data-kid=\"1-1-2-2-1-4-4\" data-name=\"register footer with note and count\">\n                            <p class=\"text-[11px] text-[var(--app-muted)]\" data-kid=\"1-1-2-2-1-4-4-1\" data-name=\"footer disclaimer text\">\n                                Sample session values are illustrative and may not reflect current inventory.\n                            </p>\n                            <p class=\"text-[12px] font-medium text-slate-600\" data-kid=\"1-1-2-2-1-4-4-2\" data-name=\"records shown text\">\n                                5 records shown\n                            </p>\n                        </div>\n                    </section>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n",
