    },
    "var_c32e29e4689f": {
      "type": "variant",
      "label": "Admin overview · mobile",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1761.9078947368423,
        "y": -50.986842105263165,
        "w": 390,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.adimat-admin-mobile {\n  --adimat-primary: #065f46;\n  --adimat-primary-dark: #064e3b;\n  --adimat-primary-light: #059669;\n  --adimat-green-soft: #ecfdf5;\n  --adimat-canvas: #f8fafc;\n  --adimat-surface-muted: #f1f5f4;\n  --adimat-card: #ffffff;\n  --adimat-border: #dbe4e1;\n  --adimat-ink: #0f172a;\n  --adimat-muted: #64748b;\n  width: 100%;\n  max-width: 390px;\n  height: 844px;\n  max-height: 100vh;\n  min-height: 700px;\n  margin-inline: auto;\n  overflow: hidden;\n  color: var(--adimat-ink);\n  background: var(--adimat-canvas);\n  font-family: 'DM Sans', 'Segoe UI', ui-sans-serif, system-ui, sans-serif;\n}\n</style>\n<div class=\"adimat-admin-mobile flex flex-col\" data-kid=\"1\" data-name=\"mobile admin app layout container\">\n    <header class=\"shrink-0 bg-[var(--adimat-primary)] px-4 pt-3 pb-3 text-white\" data-kid=\"1-1\" data-name=\"app header bar with brand and actions\">\n        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-1\" data-name=\"header top row with title and action buttons\">\n            <div class=\"min-w-0\" data-kid=\"1-1-1-1\" data-name=\"app title block\">\n                <p class=\"text-[10px] font-bold uppercase tracking-[0.12em] text-emerald-200\" data-kid=\"1-1-1-1-1\" data-name=\"app product label\">\n                    Adimat admin\n                </p>\n                <h1 class=\"mt-0.5 text-[22px] font-bold leading-tight tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"app page headline\">\n                    Overview\n                </h1>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-2\" data-name=\"header action button group\">\n                <button aria-label=\"Refresh overview\" class=\"flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-white\" data-kid=\"1-1-1-2-1\" data-name=\"refresh overview button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-refresh-cw text-lg\" data-kid=\"1-1-1-2-1-1\" data-name=\"refresh icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Log out\" class=\"flex h-11 w-11 items-center justify-center rounded-xl bg-white/10 text-white\" data-kid=\"1-1-1-2-2\" data-name=\"log out button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-log-out text-lg\" data-kid=\"1-1-1-2-2-1\" data-name=\"log out icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main aria-label=\"Platform administrator overview\" class=\"min-h-0 flex-1 space-y-4 overflow-y-auto overscroll-contain px-4 pt-4 pb-5\" data-kid=\"1-2\" data-name=\"main administrator content area\">\n        <section aria-labelledby=\"attention-title\" data-kid=\"1-2-1\" data-name=\"needs attention alert section\">\n            <div class=\"mb-2 flex items-baseline justify-between gap-3\" data-kid=\"1-2-1-1\" data-name=\"alert section header row\">\n                <h2 class=\"text-[15px] font-bold text-slate-900\" data-kid=\"1-2-1-1-1\" data-name=\"alert section heading\" id=\"attention-title\">\n                    Needs attention\n                </h2>\n                <span class=\"text-xs text-slate-500\" data-kid=\"1-2-1-1-2\" data-name=\"alert count summary text\">\n                    1 blocked\n                </span>\n            </div>\n            <div class=\"overflow-hidden rounded-2xl border border-[var(--adimat-border)] bg-white\" data-kid=\"1-2-1-2\" data-name=\"alert card container\">\n                <div class=\"flex min-h-[72px] items-center justify-between gap-3 px-3 py-2.5\" data-kid=\"1-2-1-2-1\" data-name=\"blocked store alert row\">\n                    <div class=\"flex min-w-0 items-start gap-2.5\" data-kid=\"1-2-1-2-1-1\" data-name=\"alert message content\">\n                        <i aria-hidden=\"true\" class=\"icon-circle-alert mt-0.5 shrink-0 text-lg text-red-700\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"alert warning icon\">\n                        </i>\n                        <div class=\"min-w-0\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"alert message text group\">\n                            <p class=\"text-sm font-semibold leading-5 text-slate-900\" data-kid=\"1-2-1-2-1-1-2-1\" data-name=\"blocked store alert title\">\n                                1 store is blocked\n                            </p>\n                            <p class=\"mt-0.5 text-xs leading-4 text-slate-600\" data-kid=\"1-2-1-2-1-1-2-2\" data-name=\"blocked store alert detail\">\n                                Access requires subscription review.\n                            </p>\n                        </div>\n                    </div>\n                    <button class=\"flex min-h-11 shrink-0 items-center gap-1 rounded-lg px-2 text-sm font-semibold text-[var(--adimat-primary)]\" data-kid=\"1-2-1-2-1-2\" data-name=\"review blocked store action button\" type=\"button\">\n                        Review\n                        <i aria-hidden=\"true\" class=\"icon-chevron-right text-base\" data-kid=\"1-2-1-2-1-2-1\" data-name=\"chevron right arrow icon\">\n                        </i>\n                    </button>\n                </div>\n                <div class=\"flex min-h-11 items-center justify-between gap-3 border-t border-slate-100 px-3\" data-kid=\"1-2-1-2-2\" data-name=\"expiring plans summary row\">\n                    <span class=\"text-[13px] text-slate-600\" data-kid=\"1-2-1-2-2-1\" data-name=\"expiring plans label\">\n                        Plans expiring in 7 days\n                    </span>\n                    <span class=\"tabular-nums text-sm font-semibold text-slate-800\" data-kid=\"1-2-1-2-2-2\" data-name=\"expiring plans count\">\n                        0\n                    </span>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"payout-title\" class=\"rounded-2xl border border-[var(--adimat-border)] bg-white px-3.5 py-3\" data-kid=\"1-2-2\" data-name=\"payout week summary card\">\n            <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-1\" data-name=\"payout week header row\">\n                <div class=\"min-w-0\" data-kid=\"1-2-2-1-1\" data-name=\"payout week title and date\">\n                    <h2 class=\"text-[13px] font-semibold text-slate-800\" data-kid=\"1-2-2-1-1-1\" data-name=\"payout week section heading\" id=\"payout-title\">\n                        Payout week\n                    </h2>\n                    <p class=\"mt-0.5 text-xs text-slate-500\" data-kid=\"1-2-2-1-1-2\" data-name=\"payout week date range\">\n                        19–25 Oct 2026\n                    </p>\n                </div>\n                <p class=\"shrink-0 tabular-nums text-[19px] font-bold leading-6 text-slate-900\" data-kid=\"1-2-2-1-2\" data-name=\"payout week total amount\">\n                    GH₵0.00\n                </p>\n            </div>\n            <div class=\"mt-2.5 flex items-center justify-between gap-3 border-t border-slate-100 pt-2\" data-kid=\"1-2-2-2\" data-name=\"payout week footer row\">\n                <p class=\"min-w-0 text-xs leading-4 text-slate-600\" data-kid=\"1-2-2-2-1\" data-name=\"payout week status message\">\n                    No Paystack collections this week.\n                </p>\n                <button class=\"flex min-h-11 shrink-0 items-center gap-1 rounded-lg px-1 text-[13px] font-semibold text-[var(--adimat-primary)]\" data-kid=\"1-2-2-2-2\" data-name=\"payouts navigation button\" type=\"button\">\n                    Payouts\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right text-base\" data-kid=\"1-2-2-2-2-1\" data-name=\"arrow up-right icon\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <section aria-labelledby=\"totals-title\" data-kid=\"1-2-3\" data-name=\"platform totals section\">\n            <div class=\"mb-1.5 flex items-baseline justify-between gap-3\" data-kid=\"1-2-3-1\" data-name=\"platform totals header row\">\n                <h2 class=\"text-[15px] font-bold text-slate-900\" data-kid=\"1-2-3-1-1\" data-name=\"platform totals heading\" id=\"totals-title\">\n                    Platform totals\n                </h2>\n                <span class=\"text-[11px] text-slate-500\" data-kid=\"1-2-3-1-2\" data-name=\"platform totals scope note\">\n                    Sales are all-time\n                </span>\n            </div>\n            <div class=\"grid grid-cols-2 gap-x-5\" data-kid=\"1-2-3-2\" data-name=\"platform totals stats grid\">\n                <div class=\"flex min-w-0 items-baseline justify-between gap-2 border-b border-slate-200/80 py-2\" data-kid=\"1-2-3-2-1\" data-name=\"stores total stat row\">\n                    <span class=\"truncate text-[13px] text-slate-600\" data-kid=\"1-2-3-2-1-1\" data-name=\"stores stat label\">\n                        Stores\n                    </span>\n                    <span class=\"tabular-nums text-[17px] font-bold text-slate-900\" data-kid=\"1-2-3-2-1-2\" data-name=\"stores stat value\">\n                        13\n                    </span>\n                </div>\n                <div class=\"flex min-w-0 items-baseline justify-between gap-2 border-b border-slate-200/80 py-2\" data-kid=\"1-2-3-2-2\" data-name=\"users total stat row\">\n                    <span class=\"truncate text-[13px] text-slate-600\" data-kid=\"1-2-3-2-2-1\" data-name=\"users stat label\">\n                        Users\n                    </span>\n                    <span class=\"tabular-nums text-[17px] font-bold text-slate-900\" data-kid=\"1-2-3-2-2-2\" data-name=\"users stat value\">\n                        26\n                    </span>\n                </div>\n                <div class=\"flex min-w-0 items-baseline justify-between gap-2 border-b border-slate-200/80 py-2\" data-kid=\"1-2-3-2-3\" data-name=\"products total stat row\">\n                    <span class=\"truncate text-[13px] text-slate-600\" data-kid=\"1-2-3-2-3-1\" data-name=\"products stat label\">\n                        Products\n                    </span>\n                    <span class=\"tabular-nums text-[17px] font-bold text-slate-900\" data-kid=\"1-2-3-2-3-2\" data-name=\"products stat value\">\n                        3,025\n                    </span>\n                </div>\n                <div class=\"flex min-w-0 items-baseline justify-between gap-2 border-b border-slate-200/80 py-2\" data-kid=\"1-2-3-2-4\" data-name=\"sales total stat row\">\n                    <span class=\"truncate text-[13px] text-slate-600\" data-kid=\"1-2-3-2-4-1\" data-name=\"sales stat label\">\n                        Sales\n                    </span>\n                    <span class=\"tabular-nums text-[17px] font-bold text-slate-900\" data-kid=\"1-2-3-2-4-2\" data-name=\"sales stat value\">\n                        369\n                    </span>\n                </div>\n            </div>\n            <div aria-label=\"Subscription status totals\" class=\"mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-slate-600\" data-kid=\"1-2-3-3\" data-name=\"subscription status totals row\">\n                <span data-kid=\"1-2-3-3-1\" data-name=\"active subscriptions count\">\n                    <strong class=\"tabular-nums font-semibold text-emerald-800\" data-kid=\"1-2-3-3-1-1\" data-name=\"active subscriptions number\">\n                        3\n                    </strong>\n                    active\n                </span>\n                <span data-kid=\"1-2-3-3-2\" data-name=\"expired subscriptions count\">\n                    <strong class=\"tabular-nums font-semibold text-slate-800\" data-kid=\"1-2-3-3-2-1\" data-name=\"expired subscriptions number\">\n                        0\n                    </strong>\n                    expired\n                </span>\n                <span data-kid=\"1-2-3-3-3\" data-name=\"no subscription count\">\n                    <strong class=\"tabular-nums font-semibold text-slate-800\" data-kid=\"1-2-3-3-3-1\" data-name=\"no subscription number\">\n                        10\n                    </strong>\n                    no subscription\n                </span>\n            </div>\n        </section>\n        <section aria-labelledby=\"stores-title\" class=\"pb-1\" data-kid=\"1-2-4\" data-name=\"stores section container\">\n            <div class=\"mb-2 flex items-center justify-between gap-3\" data-kid=\"1-2-4-1\" data-name=\"stores section header row\">\n                <div class=\"flex min-w-0 items-baseline gap-2\" data-kid=\"1-2-4-1-1\" data-name=\"stores heading and count\">\n                    <h2 class=\"text-[15px] font-bold text-slate-900\" data-kid=\"1-2-4-1-1-1\" data-name=\"stores section heading\" id=\"stores-title\">\n                        Stores\n                    </h2>\n                    <span class=\"text-xs text-slate-500\" data-kid=\"1-2-4-1-1-2\" data-name=\"stores total count\">\n                        13\n                    </span>\n                </div>\n                <button class=\"flex min-h-11 shrink-0 items-center px-1 text-[13px] font-semibold text-[var(--adimat-primary)]\" data-kid=\"1-2-4-1-2\" data-name=\"view all stores button\" type=\"button\">\n                    View all\n                </button>\n            </div>\n            <label class=\"relative mb-2 block\" data-kid=\"1-2-4-2\" data-name=\"store search input container\">\n                <span class=\"sr-only\" data-kid=\"1-2-4-2-1\" data-name=\"screen-reader only search label\">\n                    Search stores by name, Store ID or phone\n                </span>\n                <i aria-hidden=\"true\" class=\"icon-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-base text-slate-500\" data-kid=\"1-2-4-2-2\" data-name=\"search icon\">\n                </i>\n                <input class=\"h-11 w-full min-w-0 rounded-xl border border-slate-300 bg-white pl-10 pr-3 text-sm text-slate-900 placeholder:text-slate-500 focus:border-[var(--adimat-primary-light)] focus:outline-none focus:ring-2 focus:ring-emerald-600/20\" data-kid=\"1-2-4-2-3\" data-name=\"store search text field\" placeholder=\"Name, Store ID or phone\" type=\"search\"/>\n            </label>\n            <button class=\"flex min-h-[68px] w-full min-w-0 items-center justify-between gap-3 border-t border-slate-200 py-2.5 text-left\" data-kid=\"1-2-4-3\" data-name=\"blocked store list item button\" type=\"button\">\n                <span class=\"min-w-0\" data-kid=\"1-2-4-3-1\" data-name=\"store item content\">\n                    <span class=\"block truncate text-sm font-semibold text-slate-900\" data-kid=\"1-2-4-3-1-1\" data-name=\"store name title\">\n                        U’S Corner Chop Bar\n                    </span>\n                    <span class=\"mt-1 flex items-center gap-1.5 text-xs font-medium text-red-700\" data-kid=\"1-2-4-3-1-2\" data-name=\"blocked status indicator row\">\n                        <span class=\"h-1.5 w-1.5 shrink-0 rounded-full bg-red-600\" data-kid=\"1-2-4-3-1-2-1\" data-name=\"blocked status dot\">\n                        </span>\n                        Access blocked\n                    </span>\n                </span>\n                <i aria-hidden=\"true\" class=\"icon-chevron-right shrink-0 text-base text-slate-500\" data-kid=\"1-2-4-3-2\" data-name=\"store row chevron icon\">\n                </i>\n            </button>\n        </section>\n    </main>\n    <nav aria-label=\"Administrator sections\" class=\"z-10 shrink-0 border-t border-emerald-100 bg-white px-1 pb-[max(8px,env(safe-area-inset-bottom))] pt-1.5\" data-kid=\"1-3\" data-name=\"bottom tab navigation bar\">\n        <div class=\"grid grid-cols-5 gap-0.5\" data-kid=\"1-3-1\" data-name=\"tab navigation grid\">\n            <button aria-current=\"page\" class=\"flex min-h-11 min-w-0 flex-col items-center justify-center gap-0.5 rounded-xl bg-emerald-50 px-1 text-[var(--adimat-primary)]\" data-kid=\"1-3-1-1\" data-name=\"overview tab (active)\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-layout-dashboard text-lg\" data-kid=\"1-3-1-1-1\" data-name=\"dashboard icon\">\n                </i>\n                <span class=\"max-w-full truncate text-[11px] font-bold leading-4\" data-kid=\"1-3-1-1-2\" data-name=\"overview tab label\">\n                    Overview\n                </span>\n            </button>\n            <button class=\"flex min-h-11 min-w-0 flex-col items-center justify-center gap-0.5 rounded-xl px-1 text-slate-600\" data-kid=\"1-3-1-2\" data-name=\"stores tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-store text-lg\" data-kid=\"1-3-1-2-1\" data-name=\"store icon\">\n                </i>\n                <span class=\"max-w-full truncate text-[11px] font-medium leading-4\" data-kid=\"1-3-1-2-2\" data-name=\"stores tab label\">\n                    Stores\n                </span>\n            </button>\n            <button class=\"flex min-h-11 min-w-0 flex-col items-center justify-center gap-0.5 rounded-xl px-1 text-slate-600\" data-kid=\"1-3-1-3\" data-name=\"subscriptions tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-calendar-clock text-lg\" data-kid=\"1-3-1-3-1\" data-name=\"calendar clock icon\">\n                </i>\n                <span class=\"max-w-full truncate text-[11px] font-medium leading-4\" data-kid=\"1-3-1-3-2\" data-name=\"subscriptions tab label\">\n                    Subs\n                </span>\n            </button>\n            <button class=\"flex min-h-11 min-w-0 flex-col items-center justify-center gap-0.5 rounded-xl px-1 text-slate-600\" data-kid=\"1-3-1-4\" data-name=\"payouts tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-wallet-cards text-lg\" data-kid=\"1-3-1-4-1\" data-name=\"wallet cards icon\">\n                </i>\n                <span class=\"max-w-full truncate text-[11px] font-medium leading-4\" data-kid=\"1-3-1-4-2\" data-name=\"payouts tab label\">\n                    Payouts\n                </span>\n            </button>\n            <button class=\"flex min-h-11 min-w-0 flex-col items-center justify-center gap-0.5 rounded-xl px-1 text-slate-600\" data-kid=\"1-3-1-5\" data-name=\"more options tab\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"icon-ellipsis text-lg\" data-kid=\"1-3-1-5-1\" data-name=\"ellipsis icon\">\n                </i>\n                <span class=\"max-w-full truncate text-[11px] font-medium leading-4\" data-kid=\"1-3-1-5-2\" data-name=\"more tab label\">\n                    More\n                </span>\n            </button>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-10-20T10:17:30.583998+00:00",
      "modified": "2026-10-20T10:17:55.626603+00:00",
