      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"min-h-screen bg-[var(--app-canvas)] font-[DM_Sans] text-[var(--app-ink)] antialiased\" data-kid=\"1\" data-name=\"app shell with canvas background and font setup\" style=\"--app-primary:#065f46;--app-primary-dark:#064e3b;--app-primary-light:#059669;--app-primary-soft:#ecfdf5;--app-canvas:#f8fafc;--app-paper:#ffffff;--app-border:#dbe4e1;--app-muted:#64748b;--app-subtle:#f1f5f4;\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"app row layout with sidebar and main\">\n        <aside class=\"hidden w-[248px] shrink-0 flex-col bg-[var(--app-primary-dark)] text-white lg:flex\" data-kid=\"1-1-1\" data-name=\"sidebar navigation panel\">\n            <div class=\"flex h-[76px] items-center gap-3 border-b border-white/10 px-5\" data-kid=\"1-1-1-1\" data-name=\"sidebar brand header\">\n                <div class=\"flex h-10 w-10 items-center justify-center overflow-hidden rounded-xl bg-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo badge\">\n                    <img alt=\"Adimat\" class=\"h-8 w-8 object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" height=\"32\" loading=\"lazy\" src=\"/api/local/images/public/logo.png\" width=\"32\"/>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand text block\">\n                    <p class=\"truncate text-[16px] font-bold leading-tight tracking-tight\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name heading\">\n                        Adimat\n                    </p>\n                    <p class=\"mt-0.5 text-[11px] font-medium text-emerald-100/80\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline text\">\n                        Store operations\n                    </p>\n                </div>\n            </div>\n            <div class=\"border-b border-white/10 px-4 py-4\" data-kid=\"1-1-1-2\" data-name=\"current store selector section\">\n                <p class=\"mb-2 px-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-emerald-100/70\" data-kid=\"1-1-1-2-1\" data-name=\"current store section label\">\n                    Current store\n                </p>\n                <button aria-label=\"Current store: GHALaJ ENTERPRISE\" class=\"flex min-h-12 w-full items-center gap-2.5 rounded-xl border border-white/15 bg-white/10 px-3 text-left\" data-kid=\"1-1-1-2-2\" data-name=\"current store switcher button\" type=\"button\">\n                    <span class=\"flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white/10 text-emerald-100\" data-kid=\"1-1-1-2-2-1\" data-name=\"store icon wrapper\">\n                        <i aria-hidden=\"true\" class=\"icon-store text-[17px]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"store icon\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-2\" data-name=\"current store name wrapper\">\n                        <span class=\"block truncate text-[12px] font-semibold\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"current store name text\">\n                            GHALaJ ENTERPRISE\n                        </span>\n                        <span class=\"mt-0.5 block text-[10px] text-emerald-100/75\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"current store access role text\">\n                            Owner access\n                        </span>\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon-chevrons-up-down shrink-0 text-[15px] text-emerald-100/80\" data-kid=\"1-1-1-2-2-3\" data-name=\"store switcher expand chevron icon\">\n                    </i>\n                </button>\n            </div>\n            <nav aria-label=\"Store navigation\" class=\"min-h-0 flex-1 overflow-y-auto px-3 py-4\" data-kid=\"1-1-1-3\" data-name=\"main sidebar navigation\">\n                <div class=\"mb-4\" data-kid=\"1-1-1-3-1\" data-name=\"selling navigation group\">\n                    <p class=\"mb-1.5 px-3 text-[10px] font-semibold uppercase tracking-[0.12em] text-emerald-100/60\" data-kid=\"1-1-1-3-1-1\" data-name=\"selling group label\">\n                        Selling\n                    </p>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-1-2\" data-name=\"POS nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-scan-barcode text-[17px]\" data-kid=\"1-1-1-3-1-2-1\" data-name=\"POS barcode scan icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-2-2\" data-name=\"POS nav link text\">\n                            POS\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-1-3\" data-name=\"Sales nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-receipt text-[17px]\" data-kid=\"1-1-1-3-1-3-1\" data-name=\"Sales receipt icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-3-2\" data-name=\"Sales nav link text\">\n                            Sales\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-1-4\" data-name=\"Customers nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-users-round text-[17px]\" data-kid=\"1-1-1-3-1-4-1\" data-name=\"Customers users icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-4-2\" data-name=\"Customers nav link text\">\n                            Customers\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-1-5\" data-name=\"Returns nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-rotate-ccw text-[17px]\" data-kid=\"1-1-1-3-1-5-1\" data-name=\"Returns rollback icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-1-5-2\" data-name=\"Returns nav link text\">\n                            Returns\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mb-4\" data-kid=\"1-1-1-3-2\" data-name=\"stock navigation group\">\n                    <p class=\"mb-1.5 px-3 text-[10px] font-semibold uppercase tracking-[0.12em] text-emerald-100/60\" data-kid=\"1-1-1-3-2-1\" data-name=\"stock group label\">\n                        Stock\n                    </p>\n                    <a aria-current=\"page\" class=\"flex h-10 items-center gap-3 rounded-lg bg-[var(--app-primary-light)] px-3 text-[13px] font-semibold text-white shadow-sm\" data-kid=\"1-1-1-3-2-2\" data-name=\"Inventory nav link active\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-package-open text-[17px]\" data-kid=\"1-1-1-3-2-2-1\" data-name=\"Inventory open package icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-2-2-2\" data-name=\"Inventory nav link text\">\n                            Inventory\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-2-3\" data-name=\"Purchasing nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-truck text-[17px]\" data-kid=\"1-1-1-3-2-3-1\" data-name=\"Purchasing truck icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-2-3-2\" data-name=\"Purchasing nav link text\">\n                            Purchasing\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-2-4\" data-name=\"Branch inventory nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-arrow-left-right text-[17px]\" data-kid=\"1-1-1-3-2-4-1\" data-name=\"Branch inventory exchange arrows icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-2-4-2\" data-name=\"Branch inventory nav link text\">\n                            Branch inventory\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mb-4\" data-kid=\"1-1-1-3-3\" data-name=\"money navigation group\">\n                    <p class=\"mb-1.5 px-3 text-[10px] font-semibold uppercase tracking-[0.12em] text-emerald-100/60\" data-kid=\"1-1-1-3-3-1\" data-name=\"money group label\">\n                        Money\n                    </p>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-3-2\" data-name=\"Expenses nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-wallet text-[17px]\" data-kid=\"1-1-1-3-3-2-1\" data-name=\"Expenses wallet icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-3-2-2\" data-name=\"Expenses nav link text\">\n                            Expenses\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-3-3\" data-name=\"Cash book nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-book-open text-[17px]\" data-kid=\"1-1-1-3-3-3-1\" data-name=\"Cash book open book icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-3-3-2\" data-name=\"Cash book nav link text\">\n                            Cash book\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-3-4\" data-name=\"Reports nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-chart-no-axes-column-increasing text-[17px]\" data-kid=\"1-1-1-3-3-4-1\" data-name=\"Reports growth chart icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-3-4-2\" data-name=\"Reports nav link text\">\n                            Reports\n                        </span>\n                    </a>\n                </div>\n                <div data-kid=\"1-1-1-3-4\" data-name=\"store navigation group\">\n                    <p class=\"mb-1.5 px-3 text-[10px] font-semibold uppercase tracking-[0.12em] text-emerald-100/60\" data-kid=\"1-1-1-3-4-1\" data-name=\"store group label\">\n                        Store\n                    </p>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-4-2\" data-name=\"Online nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-shopping-bag text-[17px]\" data-kid=\"1-1-1-3-4-2-1\" data-name=\"Online shopping bag icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-4-2-2\" data-name=\"Online nav link text\">\n                            Online\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-4-3\" data-name=\"Plan nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-calendar-days text-[17px]\" data-kid=\"1-1-1-3-4-3-1\" data-name=\"Plan calendar icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-4-3-2\" data-name=\"Plan nav link text\">\n                            Plan\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-4-4\" data-name=\"Settings nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-settings-2 text-[17px]\" data-kid=\"1-1-1-3-4-4-1\" data-name=\"Settings gear icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-4-4-2\" data-name=\"Settings nav link text\">\n                            Settings\n                        </span>\n                    </a>\n                    <a class=\"flex h-10 items-center gap-3 rounded-lg px-3 text-[13px] font-medium text-emerald-50/90\" data-kid=\"1-1-1-3-4-5\" data-name=\"Learn Adimat nav link\" href=\"#\">\n                        <i aria-hidden=\"true\" class=\"icon-book-open-check text-[17px]\" data-kid=\"1-1-1-3-4-5-1\" data-name=\"Learn Adimat book with check icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-3-4-5-2\" data-name=\"Learn Adimat nav link text\">\n                            Learn Adimat\n                        </span>\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-white/10 p-4\" data-kid=\"1-1-1-4\" data-name=\"sidebar account footer\">\n                <div class=\"flex min-h-11 items-center gap-3 rounded-xl px-2\" data-kid=\"1-1-1-4-1\" data-name=\"account summary row\">\n                    <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15 text-emerald-50\" data-kid=\"1-1-1-4-1-1\" data-name=\"account avatar circle\">\n                        <i aria-hidden=\"true\" class=\"icon-user-round text-[17px]\" data-kid=\"1-1-1-4-1-1-1\" data-name=\"account user icon\">\n                        </i>\n                    </span>\n                    <span class=\"min-w-0 flex-1\" data-kid=\"1-1-1-4-1-2\" data-name=\"account name wrapper\">\n                        <span class=\"block text-[12px] font-semibold\" data-kid=\"1-1-1-4-1-2-1\" data-name=\"account display name text\">\n                            Store owner\n                        </span>\n                        <span class=\"block text-[10px] text-emerald-100/75\" data-kid=\"1-1-1-4-1-2-2\" data-name=\"account role text\">\n                            Owner account\n                        </span>\n                    </span>\n                    <button aria-label=\"Account options\" class=\"flex h-9 w-9 items-center justify-center rounded-lg text-emerald-100/85\" data-kid=\"1-1-1-4-1-3\" data-name=\"account options button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-ellipsis text-[18px]\" data-kid=\"1-1-1-4-1-3-1\" data-name=\"account options ellipsis icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n        </aside>\n        <main class=\"flex min-w-0 flex-1 flex-col\" data-kid=\"1-1-2\" data-name=\"main content column\">\n            <header class=\"flex h-[60px] shrink-0 items-center justify-between border-b border-[var(--app-border)] bg-[var(--app-paper)] px-6 lg:px-8\" data-kid=\"1-1-2-1\" data-name=\"top header bar\">\n                <div class=\"flex items-center gap-2 text-[12px] text-[var(--app-muted)]\" data-kid=\"1-1-2-1-1\" data-name=\"breadcrumb nav\">\n                    <span data-kid=\"1-1-2-1-1-1\" data-name=\"breadcrumb root label\">\n                        Store\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon-chevron-right text-[13px]\" data-kid=\"1-1-2-1-1-2\" data-name=\"breadcrumb separator chevron icon\">\n                    </i>\n                    <span class=\"font-semibold text-[var(--app-primary)]\" data-kid=\"1-1-2-1-1-3\" data-name=\"breadcrumb current page label\">\n                        Inventory\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-2\" data-name=\"header actions group\">\n                    <button aria-label=\"Help with inventory\" class=\"flex h-10 w-10 items-center justify-center rounded-xl text-[var(--app-muted)]\" data-kid=\"1-1-2-1-2-1\" data-name=\"help button\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"icon-circle-help text-[18px]\" data-kid=\"1-1-2-1-2-1-1\" data-name=\"help circle icon\">\n                        </i>\n                    </button>\n                </div>\n            </header>\n            <div class=\"min-h-0 flex-1 overflow-y-auto\" data-kid=\"1-1-2-2\" data-name=\"main content scroll area\">\n                <div class=\"mx-auto w-full max-w-[1320px] px-6 pb-8 pt-7 lg:px-8\" data-kid=\"1-1-2-2-1\" data-name=\"page container with max-width\">\n                    <div class=\"mb-6 flex flex-wrap items-end justify-between gap-4\" data-kid=\"1-1-2-2-1-1\" data-name=\"page header row\">\n                        <div data-kid=\"1-1-2-2-1-1-1\" data-name=\"page title area\">\n                            <h1 class=\"text-[27px] font-bold leading-tight tracking-[-0.025em] text-[var(--app-ink)]\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"page title heading\">\n                                Inventory\n                            </h1>\n                            <p class=\"mt-1.5 text-[14px] leading-5 text-[var(--app-muted)]\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"page subtitle text\">\n                                Find products, review stock and make an adjustment.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"page action buttons\">\n                            <button class=\"inline-flex h-11 items-center gap-2 rounded-xl border border-[var(--app-border)] bg-white px-3.5 text-[13px] font-semibold text-slate-700\" data-kid=\"1-1-2-2-1-1-2-1\" data-name=\"import CSV button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"icon-upload text-[16px]\" data-kid=\"1-1-2-2-1-1-2-1-1\" data-name=\"import upload icon\">\n                                </i>\n                                <span data-kid=\"1-1-2-2-1-1-2-1-2\" data-name=\"import CSV button label\">\n                                    Import CSV\n                                </span>\n                            </button>\n                            <button class=\"inline-flex h-11 items-center gap-2 rounded-xl border border-[var(--app-border)] bg-white px-3.5 text-[13px] font-semibold text-slate-700\" data-kid=\"1-1-2-2-1-1-2-2\" data-name=\"export dropdown button\" type=\"button\">\n                                <i aria-hidden=\"true\" class=\"icon-download text-[16px]\" data-kid=\"1-1-2-2-1-1-2-2-1\" data-name=\"export download icon\">\n                                </i>\n                                <span data-kid=\"1-1-2-2-1-1-2-2-2\" data-name=\"export button label\">\n                                    Export\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon-chevron-down ml-0.5 text-[13px]\" data-kid=\"1-1-2-2-1-1-2-2-3\" data-name=\"export dropdown chevron icon\">\n                                </i>\n                            </button>\n                            <button class=\"inline-flex h-11 items-center gap-2 rounded-xl bg-[var(--app-primary)] px-4 text-[13px] font-semibold text-white shadow-sm\" data-kid=\"1-1-2-2-1-1-2-3\" data-name=\"add product primary button\" type=\"button\">\n                                