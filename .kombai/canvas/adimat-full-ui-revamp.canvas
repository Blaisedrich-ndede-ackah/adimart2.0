    "var_c91dabab4dac": {
      "type": "variant",
      "label": "Admin overview · desktop",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 4550,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n:root {\n  --color-primary: #065f46;\n  --color-primary-light: #059669;\n  --color-primary-dark: #064e3b;\n  --color-primary-subtle: #ecfdf5;\n  --color-accent: #d97706;\n  --color-danger: #dc2626;\n  --color-success: #16a34a;\n  --color-surface: #f8fafc;\n  --color-surface-muted: #f1f5f4;\n  --color-surface-card: #ffffff;\n  --color-border: #dbe4e1;\n  --color-ink: #0f172a;\n  --color-muted: #64748b;\n}\n</style>\n<div class=\"min-h-[900px] w-full bg-[var(--color-surface)] text-[var(--color-ink)]\" data-kid=\"1\" data-name=\"admin dashboard page container\" style=\"font-family:'DM Sans','Segoe UI',ui-sans-serif,system-ui,sans-serif\">\n    <header class=\"h-[76px] bg-[var(--color-primary)] text-white\" data-kid=\"1-1\" data-name=\"administrator header bar\">\n        <div class=\"mx-auto flex h-full max-w-[1440px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"header layout container\">\n            <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand and page title group\">\n                <div class=\"grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-xl bg-white\" data-kid=\"1-1-1-1-1\" data-name=\"app logo badge\">\n                    <img alt=\"Adimat\" class=\"h-8 w-8 object-contain\" data-kid=\"1-1-1-1-1-1\" data-name=\"Adimat logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo.png\"/>\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand name block\">\n                    <p class=\"text-[15px] font-bold leading-5 tracking-tight\" data-kid=\"1-1-1-1-2-1\" data-name=\"product wordmark text\">\n                        Adimat\n                        <span class=\"ml-1 text-emerald-200\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"Admin accent label\">\n                            Admin\n                        </span>\n                    </p>\n                    <p class=\"text-[11px] font-medium leading-4 text-emerald-100/90\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline text\">\n                        Platform operations\n                    </p>\n                </div>\n                <span class=\"mx-3 h-8 w-px bg-white/20\" data-kid=\"1-1-1-1-3\" data-name=\"vertical divider line\">\n                </span>\n                <h1 class=\"text-[19px] font-semibold tracking-tight\" data-kid=\"1-1-1-1-4\" data-name=\"page heading text\">\n                    Overview\n                </h1>\n            </div>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2\" data-name=\"header action buttons group\">\n                <button aria-label=\"Refresh overview\" class=\"touch-target inline-flex h-11 min-w-11 items-center justify-center gap-2 rounded-xl bg-white/10 px-3 text-sm font-semibold text-white hover:bg-white/15\" data-kid=\"1-1-1-2-1\" data-name=\"refresh button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-refresh-cw text-base\" data-kid=\"1-1-1-2-1-1\" data-name=\"refresh icon\" style=\"color:currentColor;width:18px;height:18px\">\n                    </i>\n                    <span data-kid=\"1-1-1-2-1-2\" data-name=\"refresh button label\">\n                        Refresh\n                    </span>\n                </button>\n                <button aria-label=\"Log out\" class=\"touch-target inline-flex h-11 min-w-11 items-center justify-center rounded-xl bg-white/10 px-3 text-sm font-semibold text-white hover:bg-white/15\" data-kid=\"1-1-1-2-2\" data-name=\"log out button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-log-out text-base\" data-kid=\"1-1-1-2-2-1\" data-name=\"log out icon\" style=\"color:currentColor;width:18px;height:18px\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <nav aria-label=\"Administrator sections\" class=\"border-b border-[var(--color-border)] bg-white\" data-kid=\"1-2\" data-name=\"sections navigation bar\">\n        <div class=\"mx-auto flex h-[58px] max-w-[1440px] items-center gap-1 overflow-x-auto px-8\" data-kid=\"1-2-1\" data-name=\"navigation tab row\">\n            <button aria-current=\"page\" class=\"touch-target relative inline-flex h-10 items-center rounded-xl bg-[var(--color-primary)] px-4 text-[13px] font-semibold text-white\" data-kid=\"1-2-1-1\" data-name=\"active Overview tab button\" type=\"button\">\n                Overview\n            </button>\n            <button class=\"touch-target inline-flex h-10 items-center rounded-xl px-3.5 text-[13px] font-semibold text-slate-600 hover:bg-emerald-50\" data-kid=\"1-2-1-2\" data-name=\"Stores navigation tab\" type=\"button\">\n                Stores\n            </button>\n            <button class=\"touch-target inline-flex h-10 items-center rounded-xl px-3.5 text-[13px] font-semibold text-slate-600 hover:bg-emerald-50\" data-kid=\"1-2-1-3\" data-name=\"Users navigation tab\" type=\"button\">\n                Users\n            </button>\n            <button class=\"touch-target inline-flex h-10 items-center rounded-xl px-3.5 text-[13px] font-semibold text-slate-600 hover:bg-emerald-50\" data-kid=\"1-2-1-4\" data-name=\"Subs navigation tab\" type=\"button\">\n                Subs\n            </button>\n            <button class=\"touch-target inline-flex h-10 items-center rounded-xl px-3.5 text-[13px] font-semibold text-slate-600 hover:bg-emerald-50\" data-kid=\"1-2-1-5\" data-name=\"Payouts navigation tab\" type=\"button\">\n                Payouts\n            </button>\n            <button class=\"touch-target inline-flex h-10 items-center rounded-xl px-3.5 text-[13px] font-semibold text-slate-600 hover:bg-emerald-50\" data-kid=\"1-2-1-6\" data-name=\"Products navi