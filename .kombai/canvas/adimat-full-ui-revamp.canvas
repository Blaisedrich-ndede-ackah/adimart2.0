GHALaJ ENTERPRISE\n                        </span>\n                    </div>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-1-2\" data-name=\"users count cell\">\n                        3\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-1-3\" data-name=\"products count cell\">\n                        652\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-1-4\" data-name=\"sales count cell\">\n                        138\n                    </span>\n                    <span class=\"text-right text-[14px] font-semibold tabular-nums text-slate-900\" data-kid=\"1-3-3-3-1-5\" data-name=\"revenue amount cell\">\n                        GH₵83,131.95\n                    </span>\n                    <span class=\"text-right text-[13px] text-emerald-800\" data-kid=\"1-3-3-3-1-6\" data-name=\"access status cell\">\n                        Active\n                    </span>\n                </div>\n                <div class=\"grid min-h-[56px] grid-cols-[minmax(300px,1.5fr)_110px_120px_100px_160px_108px] items-center gap-3 px-5 py-2.5 hover:bg-slate-50/70\" data-kid=\"1-3-3-3-2\" data-name=\"store row C2 Cosmetics\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-3-3-3-2-1\" data-name=\"store name cell\">\n                        <div class=\"grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-600\" data-kid=\"1-3-3-3-2-1-1\" data-name=\"store icon badge\">\n                            <i aria-hidden=\"true\" class=\"icon-store\" data-kid=\"1-3-3-3-2-1-1-1\" data-name=\"store icon\" style=\"color:currentColor;width:18px;height:18px\">\n                            </i>\n                        </div>\n                        <span class=\"truncate text-[14px] font-semibold text-slate-900\" data-kid=\"1-3-3-3-2-1-2\" data-name=\"store name text\">\n                            C2 Cosmetics\n                        </span>\n                    </div>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-2-2\" data-name=\"users count cell\">\n                        4\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-2-3\" data-name=\"products count cell\">\n                        610\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-2-4\" data-name=\"sales count cell\">\n                        42\n                    </span>\n                    <span class=\"text-right text-[14px] font-semibold tabular-nums text-slate-900\" data-kid=\"1-3-3-3-2-5\" data-name=\"revenue amount cell\">\n                        GH₵6,926.00\n                    </span>\n                    <span class=\"text-right text-[13px] text-emerald-800\" data-kid=\"1-3-3-3-2-6\" data-name=\"access status cell\">\n                        Active\n                    </span>\n                </div>\n                <div class=\"grid min-h-[56px] grid-cols-[minmax(300px,1.5fr)_110px_120px_100px_160px_108px] items-center gap-3 px-5 py-2.5 hover:bg-slate-50/70\" data-kid=\"1-3-3-3-3\" data-name=\"store row RANAW COLDSTORE\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-3-3-3-3-1\" data-name=\"store name cell\">\n                        <div class=\"grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-600\" data-kid=\"1-3-3-3-3-1-1\" data-name=\"store icon badge\">\n                            <i aria-hidden=\"true\" class=\"icon-store\" data-kid=\"1-3-3-3-3-1-1-1\" data-name=\"store icon\" style=\"color:currentColor;width:18px;height:18px\">\n                            </i>\n                        </div>\n                        <span class=\"truncate text-[14px] font-semibold text-slate-900\" data-kid=\"1-3-3-3-3-1-2\" data-name=\"store name text\">\n                            RANAW COLDSTORE\n                        </span>\n                    </div>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-3-2\" data-name=\"users count cell\">\n                        1\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-3-3\" data-name=\"products count cell\">\n                        27\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-3-4\" data-name=\"sales count cell\">\n                        12\n                    </span>\n                    <span class=\"text-right text-[14px] font-semibold tabular-nums text-slate-900\" data-kid=\"1-3-3-3-3-5\" data-name=\"revenue amount cell\">\n                        GH₵6,170.00\n                    </span>\n                    <span class=\"text-right text-[13px] text-emerald-800\" data-kid=\"1-3-3-3-3-6\" data-name=\"access status cell\">\n                        Active\n                    </span>\n                </div>\n                <div class=\"grid min-h-[56px] grid-cols-[minmax(300px,1.5fr)_110px_120px_100px_160px_108px] items-center gap-3 px-5 py-2.5 hover:bg-slate-50/70\" data-kid=\"1-3-3-3-4\" data-name=\"store row O.P. TRUST\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-3-3-3-4-1\" data-name=\"store name cell\">\n                        <div class=\"grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-slate-100 text-slate-600\" data-kid=\"1-3-3-3-4-1-1\" data-name=\"store icon badge\">\n                            <i aria-hidden=\"true\" class=\"icon-store\" data-kid=\"1-3-3-3-4-1-1-1\" data-name=\"store icon\" style=\"color:currentColor;width:18px;height:18px\">\n                            </i>\n                        </div>\n                        <span class=\"truncate text-[14px] font-semibold text-slate-900\" data-kid=\"1-3-3-3-4-1-2\" data-name=\"store name text\">\n                            O.P.O TRUST PHONE ACCESSORIES\n                        </span>\n                    </div>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-4-2\" data-name=\"users count cell\">\n                        3\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-4-3\" data-name=\"products count cell\">\n                        98\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-4-4\" data-name=\"sales count cell\">\n                        64\n                    </span>\n                    <span class=\"text-right text-[14px] font-semibold tabular-nums text-slate-900\" data-kid=\"1-3-3-3-4-5\" data-name=\"revenue amount cell\">\n                        GH₵5,646.00\n                    </span>\n                    <span class=\"text-right text-[13px] text-emerald-800\" data-kid=\"1-3-3-3-4-6\" data-name=\"access status cell\">\n                        Active\n                    </span>\n                </div>\n                <div class=\"grid min-h-[56px] grid-cols-[minmax(300px,1.5fr)_110px_120px_100px_160px_108px] items-center gap-3 px-5 py-2.5 hover:bg-red-50/40\" data-kid=\"1-3-3-3-5\" data-name=\"store row U'S Corner Chop Bar (blocked)\">\n                    <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-3-3-3-5-1\" data-name=\"store name cell\">\n                        <div class=\"grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-red-50 text-red-700\" data-kid=\"1-3-3-3-5-1-1\" data-name=\"store icon badge\">\n                            <i aria-hidden=\"true\" class=\"icon-store\" data-kid=\"1-3-3-3-5-1-1-1\" data-name=\"store icon\" style=\"color:currentColor;width:18px;height:18px\">\n                            </i>\n                        </div>\n                        <span class=\"truncate text-[14px] font-semibold text-slate-900\" data-kid=\"1-3-3-3-5-1-2\" data-name=\"store name text\">\n                            U’S Corner Chop Bar\n                        </span>\n                    </div>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-5-2\" data-name=\"users count cell\">\n                        1\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-5-3\" data-name=\"products count cell\">\n                        0\n                    </span>\n                    <span class=\"text-right text-[13px] tabular-nums text-slate-700\" data-kid=\"1-3-3-3-5-4\" data-name=\"sales count cell\">\n                        0\n                    </span>\n                    <span class=\"text-right text-[14px] font-semibold tabular-nums text-slate-900\" data-kid=\"1-3-3-3-5-5\" data-name=\"revenue amount cell\">\n                        GH₵0.00\n                    </span>\n                    <span class=\"text-right\" data-kid=\"1-3-3-3-5-6\" data-name=\"access status cell\">\n                        <span class=\"inline-flex h-7 items-center rounded-md bg-red-50 px-2 text-[12px] font-semibold text-red-800\" data-kid=\"1-3-3-3-5-6-1\" data-name=\"blocked status badge\">\n                            Blocked\n                        </span>\n                    </span>\n                </div>\n            </div>\n            <div class=\"flex items-center justify-between border-t border-slate-100 px-5 py-3 text-[12px] text-slate-500\" data-kid=\"1-3-3-4\" data-name=\"table footer row\">\n                <span data-kid=\"1-3-3-4-1\" data-name=\"footer summary text\">\n                    Showing 5 stores\n                    <span class=\"mx-1 text-slate-300\" data-kid=\"1-3-3-4-1-1\" data-name=\"separator dot\">\n                        ·\n                    </span>\n                    Search to locate another store\n                </span>\n                <button class=\"touch-target inline-flex h-9 items-center gap-1 rounded-lg px-2 font-semibold text-[var(--color-primary)] hover:bg-emerald-50\" data-kid=\"1-3-3-4-2\" data-name=\"view all stores button\" type=\"button\">\n                    Stores\n                    <i aria-hidden=\"true\" class=\"icon-arrow-up-right\" data-kid=\"1-3-3-4-2-1\" data-name=\"arrow up-right icon\" style=\"color:currentColor;width:14px;height:14px\">\n                    </i>\n                </button>\n            </div>\n        </section>\n        <p class=\"mt-3 text-[11px] text-slate-500\" data-kid=\"1-3-4\" data-name=\"footnote disclaimer text\">\n            Paystack collections shown by the selected payout week; platform and store-register revenue totals are all time.\n        </p>\n    </main>\n</div>\n",
