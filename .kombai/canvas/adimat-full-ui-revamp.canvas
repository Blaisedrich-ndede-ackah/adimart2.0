      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"mx-auto flex h-[100svh] min-h-[780px] w-full max-w-[390px] flex-col overflow-hidden bg-[var(--adimat-canvas)] font-sans text-[var(--adimat-ink)]\" data-kid=\"1\" data-name=\"settings page mobile layout container\" style=\"--adimat-green:#065f46;--adimat-green-dark:#064e3b;--adimat-green-light:#059669;--adimat-green-pale:#ecfdf5;--adimat-canvas:#f8fafc;--adimat-surface:#ffffff;--adimat-soft:#f1f5f4;--adimat-border:#dbe4e1;--adimat-ink:#0f172a;--adimat-muted:#64748b;--adimat-amber:#d97706;\">\n    <header class=\"z-10 shrink-0 bg-[var(--adimat-green)] px-5 pb-3 pt-[max(12px,env(safe-area-inset-top))] text-white\" data-kid=\"1-1\" data-name=\"green app header bar\">\n        <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-1\" data-name=\"header title row\">\n            <div class=\"min-w-0\" data-kid=\"1-1-1-1\" data-name=\"header title block\">\n                <p class=\"text-[11px] font-semibold tracking-[0.08em] text-emerald-100\" data-kid=\"1-1-1-1-1\" data-name=\"header owner badge label\">\n                    ADIMAT · OWNER\n                </p>\n                <h1 class=\"mt-0.5 text-[22px] font-bold leading-tight tracking-[-0.02em]\" data-kid=\"1-1-1-1-2\" data-name=\"settings page title\">\n                    Settings\n                </h1>\n            </div>\n            <span aria-hidden=\"true\" class=\"grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/10 text-emerald-50\" data-kid=\"1-1-1-2\" data-name=\"header icon tile\">\n                <i class=\"icon-store text-xl\" data-kid=\"1-1-1-2-1\" data-name=\"store icon\">\n                </i>\n            </span>\n        </div>\n    </header>\n    <main class=\"min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 pb-4 pt-4 [scrollbar-width:thin]\" data-kid=\"1-2\" data-name=\"scrollable main content area\" style=\"-webkit-overflow-scrolling:touch\">\n        <section aria-labelledby=\"settings-index-title\" data-kid=\"1-2-1\" data-name=\"settings sections index section\">\n            <div class=\"mb-2 flex items-baseline justify-between gap-2\" data-kid=\"1-2-1-1\" data-name=\"section index header row\">\n                <h2 class=\"text-sm font-bold text-[var(--adimat-ink)]\" data-kid=\"1-2-1-1-1\" data-name=\"section index title\" id=\"settings-index-title\">\n                    Settings sections\n                </h2>\n                <span class=\"text-xs font-medium text-[var(--adimat-muted)]\" data-kid=\"1-2-1-1-2\" data-name=\"section index area count label\">\n                    8 areas\n                </span>\n            </div>\n            <nav aria-label=\"Settings sections\" class=\"grid grid-cols-2 gap-1.5\" data-kid=\"1-2-1-2\" data-name=\"settings sections navigation grid\">\n                <button class=\"flex min-h-11 items-center gap-2 rounded-xl border border-[var(--adimat-border)] bg-white px-2.5 text-left text-[12px] font-medium text-slate-700\" data-kid=\"1-2-1-2-1\" data-name=\"store profile settings button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-store shrink-0 text-base text-slate-500\" data-kid=\"1-2-1-2-1-1\" data-name=\"store icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-1-2\" data-name=\"store profile button label\">\n                        Store profile\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon-chevron-right shrink-0 text-sm text-slate-400\" data-kid=\"1-2-1-2-1-3\" data-name=\"right chevron icon\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-11 items-center gap-2 rounded-xl border border-[var(--adimat-border)] bg-white px-2.5 text-left text-[12px] font-medium text-slate-700\" data-kid=\"1-2-1-2-2\" data-name=\"language and currency settings button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-languages shrink-0 text-base text-slate-500\" data-kid=\"1-2-1-2-2-1\" data-name=\"languages icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-2-2\" data-name=\"language and currency button label\">\n                        Language & currency\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon-chevron-right shrink-0 text-sm text-slate-400\" data-kid=\"1-2-1-2-2-3\" data-name=\"right chevron icon\">\n                    </i>\n                </button>\n                <button aria-current=\"page\" class=\"flex min-h-11 items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-2.5 text-left text-[12px] font-bold text-[var(--adimat-green)] ring-1 ring-emerald-100\" data-kid=\"1-2-1-2-3\" data-name=\"payout account settings button in selected state\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-wallet-cards shrink-0 text-base text-[var(--adimat-green)]\" data-kid=\"1-2-1-2-3-1\" data-name=\"wallet cards icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-3-2\" data-name=\"payout account button label\">\n                        Payout account\n                    </span>\n                    <span aria-label=\"Selected\" class=\"h-2 w-2 shrink-0 rounded-full bg-[var(--adimat-green)]\" data-kid=\"1-2-1-2-3-3\" data-name=\"selected state indicator dot\">\n                    </span>\n                </button>\n                <button class=\"flex min-h-11 items-center gap-2 rounded-xl border border-[var(--adimat-border)] bg-white px-2.5 text-left text-[12px] font-medium text-slate-700\" data-kid=\"1-2-1-2-4\" data-name=\"discount controls settings button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-percent shrink-0 text-base text-slate-500\" data-kid=\"1-2-1-2-4-1\" data-name=\"percent icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-4-2\" data-name=\"discount controls button label\">\n                        Discount controls\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon-chevron-right shrink-0 text-sm text-slate-400\" data-kid=\"1-2-1-2-4-3\" data-name=\"right chevron icon\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-11 items-center gap-2 rounded-xl border border-[var(--adimat-border)] bg-white px-2.5 text-left text-[12px] font-medium text-slate-700\" data-kid=\"1-2-1-2-5\" data-name=\"security and login settings button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-shield-check shrink-0 text-base text-slate-500\" data-kid=\"1-2-1-2-5-1\" data-name=\"shield check icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-5-2\" data-name=\"security and login button label\">\n                        Security & login\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon-chevron-right shrink-0 text-sm text-slate-400\" data-kid=\"1-2-1-2-5-3\" data-name=\"right chevron icon\">\n                    </i>\n                </button>\n                <button class=\"flex min-h-11 items-center gap-2 rounded-xl border border-[var(--adimat-border)] bg-white px-2.5 text-left text-[12px] font-medium text-slate-700\" data-kid=\"1-2-1-2-6\" data-name=\"staff settings button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-users shrink-0 text-base text-slate-500\" data-kid=\"1-2-1-2-6-1\" data-name=\"users icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-6-2\" data-name=\"staff button label\">\n                        Staff\n                    </span>\n                    <span class=\"text-[9px] font-semibold text-slate-500\" data-kid=\"1-2-1-2-6-3\" data-name=\"status live badge\">\n                        LIVE\n                    </span>\n                </button>\n                <button class=\"flex min-h-11 items-center gap-2 rounded-xl border border-[var(--adimat-border)] bg-white px-2.5 text-left text-[12px] font-medium text-slate-700\" data-kid=\"1-2-1-2-7\" data-name=\"cloud sync settings button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-cloud-sync shrink-0 text-base text-slate-500\" data-kid=\"1-2-1-2-7-1\" data-name=\"cloud sync icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-7-2\" data-name=\"cloud sync button label\">\n                        Sync\n                    </span>\n                    <span class=\"text-[9px] font-semibold text-slate-500\" data-kid=\"1-2-1-2-7-3\" data-name=\"active sync indicator dot\">\n                        LIVE\n                    </span>\n                </button>\n                <button class=\"flex min-h-11 items-center gap-2 rounded-xl border border-[var(--adimat-border)] bg-white px-2.5 text-left text-[12px] font-medium text-slate-700\" data-kid=\"1-2-1-2-8\" data-name=\"backup settings button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"icon-archive shrink-0 text-base text-slate-500\" data-kid=\"1-2-1-2-8-1\" data-name=\"archive icon\">\n                    </i>\n                    <span class=\"min-w-0 flex-1 leading-tight\" data-kid=\"1-2-1-2-8-2\" data-name=\"backup button label\">\n                        Backup\n                    </span>\n                    <i aria-hidden=\"true\" class=\"icon-chevron-right shrink-0 text-sm text-slate-400\" data-kid=\"1-2-1-2-8-3\" data-name=\"right chevron icon\">\n                    </i>\n                </button>\n            </nav>\n        </section>\n        <section aria-labelledby=\"payout-section-title\" class=\"mt-5\" data-kid=\"1-2-2\" data-name=\"payout account settings section\">\n            <div class=\"mb-3\" data-kid=\"1-2-2-1\" data-name=\"payout account section header block\">\n                <h2 class=\"text-lg font-bold tracking-[-0.02em] text-[var(--adimat-ink)]\" data-kid=\"1-2-2-1-1\" data-name=\"payout account section title\" id=\"payout-section-title\">\n                    Payout account\n                </h2>\n                <p class=\"mt-1 text-[13px] leading-5 text-slate-600\" data-kid=\"1-2-2-1-2\" data-name=\"payout account section description\">\n                    Account details the administrator uses when recording weekly Paystack remittances. Saving here does not transfer money.\n                </p>\n            </div>\n            <div class=\"space-y-3 rounded-2xl border border-[var(--adimat-border)] bg-white p-4\" data-kid=\"1-2-2-2\" data-name=\"payout account form card\">\n                <label class=\"block\" data-kid=\"1-2-2-2-1\" data-name=\"account name field group\">\n                    <span class=\"mb-1.5 block text-[13px] font-semibold text-slate-800\" data-kid=\"1-2-2-2-1-1\" data-name=\"account name field label\">\n                        Account name\n                    </span>\n                    <input class=\"h-12 w-full rounded-xl border border-slate-300 bg-white px-3.5 text-base text-slate-900 placeholder:text-slate-500 focus:border-[var(--adimat-green)] focus:outline-none focus:ring-2 focus:ring-emerald-200\" data-kid=\"1-2-2-2-1-2\" data-name=\"account name text input\" placeholder=\"Name on MoMo wallet\" type=\"text\"/>\n                </label>\n                <label class=\"block\" data-kid=\"1-2-2-2-2\" data-name=\"momo number field group\">\n                    <span class=\"mb-1.5 block text-[13px] font-semibold text-slate-800\" data-kid=\"1-2-2-2-2-1\" data-name=\"momo number field label\">\n                        MoMo number\n                    </span>\n                    <input class=\"h-12 w-full rounded-xl border border-slate-300 bg-white px-3.5 text-base text-slate-900 placeholder:text-slate-500 focus:border-[var(--adimat-green)] focus:outline-none focus:ring-2 focus:ring-emerald-200\" data-kid=\"1-2-2-2-2-2\" data-name=\"momo number tel input\" inputmode=\"tel\" placeholder=\"024 XXX XXXX\" type=\"tel\"/>\n                </label>\n                <label class=\"block\" data-kid=\"1-2-2-2-3\" data-name=\"network field group\">\n                    <span class=\"mb-1.5 block text-[13px] font-semibold text-slate-800\" data-kid=\"1-2-2-2-3-1\" data-name=\"network field label\">\n                        Network\n                    </span>\n                    <div class=\"relative\" data-kid=\"1-2-2-2-3-2\" data-name=\"network field wrapper with chevron\">\n                        <select class=\"h-12 w-full appearance-none rounded-xl border border-emerald-300 bg-emerald-50/50 px-3.5 pr-10 text-base font-medium text-slate-900 focus:border-[var(--adimat-green)] focus:outline-none focus:ring-2 focus:ring-emerald-200\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"network select dropdown\">\n                            <option data-kid=\"1-2-2-2-3-2-1-1\" data-name=\"select network placeholder option\">\n                                Select network\n                            </option>\n                            <option data-kid=\"1-2-2-2-3-2-1-2\" data-name=\"MTN selected option\" selected=\"\">\n                                MTN\n                            </option>\n                            <option data-kid=\"1-2-2-2-3-2-1-3\" data-name=\"Vodafone option\">\n                                Vodafone\n                            </option>\n                            <option data-kid=\"1-2-2-2-3-2-1-4\" data-name=\"AirtelTigo option\">\n                                AirtelTigo\n                            </option>\n                            <option data-kid=\"1-2-2-2-3-2-1-5\" data-name=\"other network option\">\n                                Other\n                            </option>\n                        </select>\n                        <i aria-hidden=\"true\" class=\"icon-chevron-down pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-base text-slate-600\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"dropdown chevron icon\">\n                        </i>\n                    </div>\n                    <span class=\"mt-1.5 inline-flex items-center gap-1.5 text-xs font-semibold text-[var(--adimat-green)]\" data-kid=\"1-2-2-2-3-3\" data-name=\"network dirty state notice\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[var(--adimat-green)]\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"unsaved state dot\">\n                        </span>\n                        Network changed · not saved\n                    </span>\n                </label>\n            </div>\n            <p class=\"mt-2.5 px-1 text-xs leading-5 text-slate-600\" data-kid=\"1-2-2-3\" data-name=\"payout account disclaimer paragraph\">\n                This records the destination details for an administrator to reference. It does not initiate a transfer.\n            </p>\n        </section>\n        <section aria-labelledby=\"save-behavior-title\" class=\"mt-4 rounded-xl bg-[var(--adimat-soft)] px-3.5 py-3\" data-kid=\"1-2-3\" data-name=\"what applies now info panel\">\n            <div class=\"flex items-center gap-2\" data-kid=\"1-2-3-1\" data-name=\"info panel header row\">\n                <i aria-hidden=\"true\" class=\"icon-info text-base text-slate-600\" data-kid=\"1-2-3-1-1\" data-name=\"info icon\">\n                </i>\n                <h3 class=\"text-[13px] font-bold text-slate-800\" data-kid=\"1-2-3-1-2\" data-name=\"info panel title\" id=\"save-behavior-title\">\n                    What applies now\n                </h3>\n            </div>\n            <p class=\"mt-1.5 text-xs leading-[1.45] text-slate-700\" data-kid=\"1-2-3-2\" data-name=\"applied now description paragraph\">\n                <strong class=\"font-semibold\" data-kid=\"1-2-3-2-1\" data-name=\"applied now bold label\">\n                    Live today:\n                </strong>\n                profile, payout, discounts, currency and timeout use one\n                <strong data-kid=\"1-2-3-2-2\" data-name=\"save all highlight text\">\n                    Save All\n                </strong>\n                . Language changes immediately; its preference is also written with Save All.\n            </p>\n            <p class=\"mt-1.5 text-xs leading-[1.45] text-slate-700\" data-kid=\"1-2-3-3\" data-name=\"also immediate description paragraph\">\n                <strong class=\"font-semibold\" data-kid=\"1-2-3-3-1\" data-name=\"also immediate bold label\">\n                    Also immediate:\n                </strong>\n                staff permissions, auto-sync, PIN/biometric setup and device pairing.\n            </p>\n        </section>\n        <div aria-hidden=\"true\" class=\"h-4\" data-kid=\"1-2-4\" data-name=\"scroll spacer\">\n        </div>\n    </main>\n    <div class=\"z-20 shrink-0 border-t border-[var(--adimat-border)] bg-white px-4 pb-2 pt-2.5 shadow-[0_-4px_16px_rgba(15,23,42,0.06)]\" data-kid=\"1-3\" data-name=\"sticky bottom action bar\">\n        <div class=\"mb-2 flex items-center justify-between gap-2\" data-kid=\"1-3-1\" data-name=\"action bar status row\">\n            <span class=\"inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-[11px] font-bold text-amber-900\" data-kid=\"1-3-1-1\" data-name=\"unsaved change badge\">\n                <i aria-hidden=\"true\" class=\"icon-circle-alert text-xs\" data-kid=\"1-3-1-1-1\" data-name=\"circle alert icon\">\n                </i>\n                1 unsaved change\n            </span>\n            <span class=\"text-[10px] font-semibold text-slate-500\" data-kid=\"1-3-1-2\" data-name=\"design concept badge text\">\n                DESIGN CONCEPT · PROPOSED\n            </span>\n        </div>\n        <button class=\"flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[var(--adimat-green)] text-sm font-bold text-white shadow-sm\" data-kid=\"1-3-2\" data-name=\"save payout account CTA button\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"icon-save text-base\" data-kid=\"1-3-2-1\" data-name=\"save icon\">\n            </i>\n            Save payout account\n        </button>\n        <p class=\"mt-1.5 text-center text-[10px] leading-4 text-slate-600\" data-kid=\"1-3-3\" data-name=\"save button disclaimer text\">\n            Section-level saving is proposed here; it is not in the live app.\n        </p>\n    </div>\n    <nav aria-label=\"Main navigation\" class=\"z-10 shrink-0 border-t border-emerald-100 bg-white/95 px-2 pb-[max(6px,env(safe-area-inset-bottom))] pt-1.5\" data-kid=\"1-4\" data-name=\"bottom main navigation bar\">\n        <div class=\"flex items-center justify-around\" data-kid=\"1-4-1\" data-name=\"nav item row\">\n            <div class=\"flex min-h-11 min-w-[60px] flex-col items-center justify-center gap-0.5 rounded-xl px-2 text-slate-500\" data-kid=\"1-4-1-1\" data-name=\"home navigation item\">\n                <i aria-hidden=\"true\" class=\"icon-house text-lg\" data-kid=\"1-4-1-1-1\" data-name=\"home icon\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"1-4-1-1-2\" data-name=\"home navigation label\">\n                    Home\n                </span>\n            </div>\n            <div class=\"flex min-h-11 min-w-[60px] flex-col items-center justify-center gap-0.5 rounded-xl px-2 text-slate-500\" data-kid=\"1-4-1-2\" data-name=\"POS navigation item\">\n                <i aria-hidden=\"true\" class=\"icon-scan-barcode text-lg\" data-kid=\"1-4-1-2-1\" data-name=\"barcode scan icon\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"1-4-1-2-2\" data-name=\"POS navigation label\">\n                    POS\n                </span>\n            </div>\n            <div class=\"flex min-h-11 min-w-[60px] flex-col items-center justify-center gap-0.5 rounded-xl px-2 text-slate-500\" data-kid=\"1-4-1-3\" data-name=\"sales navigation item\">\n                <i aria-hidden=\"true\" class=\"icon-receipt text-lg\" data-kid=\"1-4-1-3-1\" data-name=\"receipt icon\">\n                </i>\n                <span class=\"text-[10px] font-medium\" data-kid=\"1-4-1-3-2\" data-name=\"sales navigation label\">\n                    Sales\n                </span>\n            </div>\n            <div class=\"flex min-h-11 min-w-[60px] flex-col items-center justify-center gap-0.5 rounded-xl bg-emerald-50 px-2 text-[var(--adimat-green)]\" data-kid=\"1-4-1-4\" data-name=\"more navigation item in active state\">\n                <i aria-hidden=\"true\" class=\"icon-ellipsis text-lg\" data-kid=\"1-4-1-4-1\" data-name=\"ellipsis icon\">\n                </i>\n                <span class=\"text-[10px] font-bold\" data-kid=\"1-4-1-4-2\" data-name=\"more navigation label\">\n                    More\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
