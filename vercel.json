{
  "rewrites": [
    {
      "source": "/shop/:slug",
      "destination": "/"
    },
    {
      "source": "/api/admin-active-devices",
      "destination": "/api/admin-monitoring?action=active-devices"
    },
    {
      "source": "/api/admin-activity-log",
      "destination": "/api/admin-monitoring?action=activity-log"
    },
    {
      "source": "/api/store-momo-payout",
      "destination": "/api/shop-checkout?action=store-momo-payout"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/integrations?action=sitemap"
    }
  ],
  "crons": [
    {
      "path": "/api/send-cloud-sync-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/integrations?action=retry-webhooks",
      "schedule": "0 10 * * *"
    }
  ]
}
